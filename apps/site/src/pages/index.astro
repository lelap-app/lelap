---
import Base from '../layouts/Base.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Lori from '../components/Lori.astro';
import CatalogMockup from '../components/CatalogMockup.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import { site } from '../site';

const features: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'moon',
    title: 'A sleep timer that fades',
    text: 'Minutes or end of chapter. Fades out over the last minute, rewinds a little so you can find your place, and a shake buys you ten more.',
  },
  {
    icon: 'plane',
    title: 'Offline first',
    text: 'Download books and episodes over Wi-Fi with the screen off. Airplane mode is a normal day, not an error state.',
  },
  {
    icon: 'cloud',
    title: 'Your server, your bucket',
    text: 'Play straight from a WebDAV server or an S3-compatible bucket. The app talks to it directly and keeps the credentials on your device.',
  },
  {
    icon: 'call',
    title: 'Keeps going through calls',
    text: 'Lower the volume instead of stopping when a call comes in. Your choice, on Android.',
  },
  {
    icon: 'sync',
    title: 'Progress that follows you',
    text: 'Pick up on your laptop where you stopped on your phone. Pair devices with a code; sync is end-to-end encrypted.',
  },
  {
    icon: 'gauge',
    title: 'Smart rewind, speed, chapters',
    text: 'Rewinds further the longer you paused. Speed per book with pitch correction and chapter-aware scrubbing.',
  },
  {
    icon: 'list',
    title: 'Playlists, tags and Up Next',
    text: 'One queue for books and episodes, hand-made lists, and smart ones like “short and not started” or “for the flight”.',
  },
  {
    icon: 'cast',
    title: 'Cast to the living room',
    text: 'Chromecast and Sonos from Android, with your progress kept while it plays.',
  },
  {
    icon: 'folder',
    title: 'Bring your own files',
    text: 'Import m4b, mp3, opus and flac, or point it at a folder. Chapters come from the tags. OPML in and out for podcasts.',
  },
];

const bare = (url: string) => url.replace(/^https?:\/\//, '');

const channels: {
  icon: IconName;
  title: string;
  where?: string;
  text: string;
  link?: { href: string; label: string; primary?: boolean };
  later?: boolean;
}[] = [
  {
    icon: 'download',
    title: 'Direct download',
    where: site.downloadsHost,
    text: 'The signed APK from our own downloads host. Once installed, the app checks for updates itself.',
    link: { href: site.apkUrl, label: 'Download .apk', primary: true },
  },
  {
    icon: 'tag',
    title: 'GitHub Releases',
    where: bare(site.releasesUrl),
    text: 'Every version with its release notes, the same APK and a build attestation.',
    link: { href: site.releasesUrl, label: 'All releases' },
  },
  {
    icon: 'sync',
    title: 'Obtainium',
    where: bare(site.repoUrl),
    text: 'Add the repository URL in Obtainium and it installs new versions from GitHub Releases.',
  },
  {
    icon: 'grid',
    title: 'F-Droid',
    text: 'Coming after version 1.0. F-Droid builds Lelap from source and, when the result matches ours, ships the same signed APK, so you can switch between F-Droid and the direct download without reinstalling.',
    later: true,
  },
];

const addonRoles = [
  ['Catalogs', 'Trending, new, your shelves'],
  ['Metadata', 'Covers, narrators, chapters'],
  ['Sources', 'Where the audio file lives'],
  ['Scrobble', 'Share progress elsewhere'],
];

const services = [
  ['web', 'The PWA, served as static files.'],
  ['catalog', 'The built-in catalog add-on: Open Library, LibriVox and Podcast Index, cached.'],
  ['proxy', 'Fetches RSS feeds and cover images for the web app. Never audio.'],
  ['sync', 'Stores encrypted progress and playlists. It can’t read them.'],
];

const compose = `services:
  web:
    image: ghcr.io/lelap-app/web
    ports: ["8080:80"]
  catalog:
    image: ghcr.io/lelap-app/catalog
    env_file: .env
  proxy:
    image: ghcr.io/lelap-app/proxy
  sync:
    image: ghcr.io/lelap-app/sync
    volumes: ["./data:/data"]`;
---

<Base>
  <section class="container hero">
    <div class="hero-copy">
      <span class="pill">
        {site.released
          ? 'Open source · Android · Web · Self-hosted'
          : site.beta
            ? 'Beta · Open source · Android and web'
            : 'In development · Open source · Android and web'}
      </span>
      <h1>{site.tagline}</h1>
      <p class="hero-lead">
        Connect the libraries you already have through add-ons, download for the flight, and drift
        off to a timer that fades. Open source, no account, no app store, no lock-in.
      </p>
      <div class="cta">
        {site.released ? (
          <>
            <a class="btn btn-lg btn-primary" href={site.appUrl}>
              Open {site.appHost}
            </a>
            <a class="btn btn-lg btn-outline" href={site.apkUrl}>
              <Icon name="download" size={18} strokeWidth={2} />
              Download for Android
            </a>
            <a class="btn-link" href="#selfhost">
              Self-host with Docker →
            </a>
          </>
        ) : (
          <>
            {site.beta && (
              <a class="btn btn-lg btn-primary" href={site.betaApkUrl}>
                <Icon name="download" size={18} strokeWidth={2} />
                Try the Android beta
              </a>
            )}
            <a
              class:list={['btn btn-lg', site.beta ? 'btn-outline' : 'btn-primary']}
              href={site.repoUrl}
            >
              <Icon name="code" size={18} strokeWidth={2} />
              Follow on GitHub
            </a>
            <a class="btn btn-lg btn-outline" href={site.briefUrl}>
              Read the plan
            </a>
          </>
        )}
      </div>
      <ul class="checks">
        <li>
          <Icon name="check" size={18} strokeWidth={2} />
          Works fully offline
        </li>
        <li>
          <Icon name="check" size={18} strokeWidth={2} />
          No account needed
        </li>
        <li>
          <Icon name="check" size={18} strokeWidth={2} />
          Audio never passes through our servers
        </li>
      </ul>
    </div>
    <div class="hero-visual">
      <PhoneMockup />
    </div>
  </section>

  <div class="band" id="how">
    <section class="container section">
      <div class="how">
        <div class="how-copy" data-reveal>
          <div class="section-head">
            <span class="eyebrow">How it works</span>
            <h2 class="h2">
              The app plays. <span class="nowrap">Add-ons</span> bring the library.
            </h2>
            <p class="lead">
              {site.name} handles playback, downloads, progress and sync. What you browse, where the
              audio lives and where your progress is shared are add-ons you choose, made and run by
              whoever builds them.
            </p>
          </div>
          <div class="chips">
            <span class="muted">Ships with open sources:</span>
            <span class="chip">LibriVox</span>
            <span class="chip">Open Library</span>
            <span class="chip">Podcast Index</span>
            <span class="chip">RSS feeds</span>
            <span class="chip">Your own files</span>
            <span class="muted chips-gap">Optional:</span>
            <span class="chip chip-dashed">Audiobookshelf</span>
            <span class="chip chip-dashed">WebDAV</span>
            <span class="chip chip-dashed">Hardcover</span>
            <span class="chip chip-dashed">gPodder</span>
          </div>
        </div>
        <div class="how-visual" data-reveal style="--i: 1">
          <CatalogMockup />
        </div>
      </div>
      <div class="grid">
        <div class="card" data-reveal>
          <span class="step">1 · Add-ons answer</span>
          <div class="roles">
            {addonRoles.map(([name, text]) => (
              <div class="role">
                <b>{name}</b>
                <span>{text}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="card" data-reveal style="--i: 1">
          <span class="step">2 · Your device keeps it</span>
          <p class="statement">
            Library, progress, downloads and playlists live on your phone first.
          </p>
          <p>
            Add-ons can be slow, offline or gone tomorrow. What you downloaded keeps playing, and
            your progress never depends on someone else’s server.
          </p>
        </div>
        <div class="card" data-reveal style="--i: 2">
          <span class="step">3 · Install by URL</span>
          <pre class="code"><code>{`GET /manifest.json
{
  "id": "org.librivox",
  "resources": ["catalog", "meta", "stream"],
  "types": ["audiobook"]
}`}</code></pre>
          <p>
            Paste an add-on’s address and you’re done. Settings live on the add-on’s own page; the
            app only remembers the URL. <a href="/docs/">Build your own</a>.
          </p>
        </div>
      </div>
    </section>
  </div>

  <section class="container section" id="features">
    <div class="features-head" data-reveal>
      <div class="section-head">
        <span class="eyebrow">Features</span>
        <h2 class="h2">Built for long listens.</h2>
      </div>
      <figure class="lori">
        {/* A details toggle, so Lori says hello without any script, and works from a keyboard. */}
        <details class="lori-hello">
          <summary aria-label="Say hello to Lori">
            <Lori size={128} class="lori-art" />
          </summary>
          <p class="lori-bubble">
            Hi, I’m Lori, a slow loris. <em>Lelap</em> is Indonesian for deep, peaceful sleep, which
            I’m very good at. I’m from Indonesia too, and I keep your place while you drift off.
          </p>
        </details>
        <figcaption>Lori, asleep before the chapter ends. Tap him.</figcaption>
      </figure>
    </div>
    <div class="grid">
      {features.map((f, i) => (
        <div class="card card-outline" data-reveal style={`--i: ${i % 3}`}>
          <span class="icon-tile">
            <Icon name={f.icon} />
          </span>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="band" id="get">
    <section class="container section">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Download</span>
        <h2 class="h2">Get it on Android, or open it in a browser.</h2>
        <p class="lead">
          {site.released
            ? 'No Play Store and no account. Every channel ships the same signed APK.'
            : site.beta
              ? 'A beta for Android is out: a test version, with rough edges. It updates itself as new betas arrive.'
              : 'Nothing to download yet. These are the ways you’ll get version 1.0.'}
        </p>
      </div>
      <div class="download">
        <div class="card android" data-reveal>
          <div class="android-head">
            <span class="get-icon">
              <Icon name="phone" size={28} strokeWidth={1.6} />
            </span>
            <div class="android-title">
              <h3 class="get-title">Android</h3>
              <span class="mono-accent">.apk · Android 8.0 or newer</span>
            </div>
            {!site.released && <span class="badge">{site.beta ? 'Beta' : 'Coming with v1.0'}</span>}
          </div>
          <p>
            The full experience: background playback, downloads with the screen off, casting and
            Android Auto. Small updates install themselves; new versions take one tap.
          </p>
          <ul class="channels">
            {channels.map((c) => (
              <li class="channel">
                <span class="icon-tile">
                  <Icon name={c.icon} />
                </span>
                <div class="channel-copy">
                  <strong>{c.title}</strong>
                  {c.where && <code class="channel-where">{c.where}</code>}
                  <p>{c.text}</p>
                </div>
                {c.later ? (
                  <span class="badge channel-end">Later</span>
                ) : (
                  (site.released || (site.beta && c.link?.primary)) &&
                  c.link && (
                    <a
                      class:list={[
                        'btn btn-sm channel-end',
                        c.link.primary ? 'btn-primary' : 'btn-outline',
                      ]}
                      href={site.beta && c.link.primary ? site.betaApkUrl : c.link.href}
                    >
                      {c.link.primary && <Icon name="download" size={18} strokeWidth={2} />}
                      {site.beta && c.link.primary ? 'Download beta .apk' : c.link.label}
                    </a>
                  )
                )}
              </li>
            ))}
          </ul>
          <div class="verify">
            <Icon name="shield" size={22} />
            {site.released ? (
              <p>
                <b>Checking the file?</b> <a href={site.releaseInfoUrl}>latest.json</a> lists the
                version, size and SHA-256 of the current APK, and each GitHub release carries the
                same file with a build attestation and a <code>SHA256SUMS</code> list. Compare with{' '}
                <code>sha256sum</code>, or run <code>gh attestation verify</code> against the
                repository.
              </p>
            ) : site.beta ? (
              <p>
                <b>Checking the file?</b> <a href={site.betaInfoUrl}>beta.json</a> lists the
                version, size and SHA-256 of the current beta, and each GitHub pre-release carries
                the same file with a build attestation.
              </p>
            ) : (
              <p>
                <b>For people who verify:</b> each release will publish the APK’s SHA-256 in{' '}
                <code>latest.json</code> on {site.downloadsHost} and on GitHub, with a build
                attestation, so you can check the file before you install it.
              </p>
            )}
          </div>
        </div>
        <div class="side">
          <div class="card get" data-reveal style="--i: 1">
            <span class="get-icon">
              <Icon name="globe" size={28} strokeWidth={1.6} />
            </span>
            <h3 class="get-title">Web app</h3>
            <span class="mono-accent">{site.appHost}</span>
            <p>
              Nothing to install. Add it to your home screen as a PWA. Best for your laptop, an
              iPhone or iPad, or any device that isn’t an Android phone.
            </p>
            {site.released ? (
              <a class="btn btn-primary get-cta" href={site.appUrl}>
                Start listening
              </a>
            ) : (
              <span class="badge get-cta">Coming with v1.0</span>
            )}
          </div>
          <div class="card get" data-reveal style="--i: 2">
            <span class="get-icon">
              <Icon name="box" size={28} strokeWidth={1.6} />
            </span>
            <h3 class="get-title">Self-hosted</h3>
            <span class="mono-accent">docker compose up</span>
            <p>
              Run the web app, catalog, feed proxy and sync on your own machine, and point the
              Android app at it.
            </p>
            <a class="btn btn-outline get-cta" href="#selfhost">
              Self-hosting
            </a>
          </div>
        </div>
      </div>
      <p class="muted small">
        No iOS app is planned. iPhone and iPad can use the web app, with streaming and in-app
        downloads.
      </p>
    </section>
  </div>

  <section class="container section selfhost" id="selfhost">
    <div class="selfhost-copy" data-reveal>
      <span class="eyebrow">Self-host</span>
      <h2 class="h2">Run the whole thing yourself.</h2>
      <p class="lead">
        Everything behind {site.appHost} is in the repository. Four small containers; sync keeps one
        SQLite file, so there is no database server to run.
      </p>
      <ul class="services">
        {services.map(([name, text]) => (
          <li>
            <span class="mono-accent">{name}</span>
            <span>{text}</span>
          </li>
        ))}
      </ul>
      {!site.released && <p class="muted small">Images are published with the first release.</p>}
    </div>
    <div class="terminal" data-reveal style="--i: 1">
      <div class="terminal-head">docker-compose.yml</div>
      <pre class="terminal-body"><code>{compose}</code></pre>
      <div class="terminal-foot">
        <span>$</span> docker compose up -d
      </div>
    </div>
  </section>

  <div class="band">
    <section class="container section">
      <h2 class="h2 narrow" data-reveal>
        Nothing to look at, by design.
      </h2>
      <div class="grid promises">
        <div data-reveal>
          <h3>No account</h3>
          <p>Your library lives on your device. There is no profile to sign up for.</p>
        </div>
        <div data-reveal style="--i: 1">
          <h3>Encrypted sync</h3>
          <p>
            Devices pair with a code. The sync server only ever sees ciphertext. Lost a phone? Reset
            sync from another device and its key opens nothing new.
          </p>
        </div>
        <div data-reveal style="--i: 2">
          <h3>No audio through us</h3>
          <p>Your phone talks to add-ons and their sources directly. We never see what you play.</p>
        </div>
        <div data-reveal style="--i: 3">
          <h3>No ads, no tracking</h3>
          <p>Open source, so you can check every line of that claim.</p>
        </div>
      </div>
    </section>
  </div>

  <section class="container section faq" id="faq">
    <h2 class="h2" data-reveal>
      Questions
    </h2>
    <div data-reveal style="--i: 1">
      {!site.released && (
        <details open>
          <summary>When can I use it?</summary>
          <p>
            {site.name} is in early development. Follow the repository on GitHub to see progress;
            the plan and the v1.0 scope are in the open.
          </p>
        </details>
      )}
      <details open={site.released}>
        <summary>Where does the audio come from?</summary>
        <p>
          From the add-ons you install. Out of the box that means public-domain audiobooks from
          LibriVox, podcast feeds and your own files. Add-ons are made and run by third parties. You
          are responsible for the add-ons you add and for only playing content you have the right
          to.
        </p>
      </details>
      <details>
        <summary>Does {site.name} list or recommend third-party add-ons?</summary>
        <p>
          No. We publish our own add-ons for open sources and the SDK, nothing else. There is no
          add-on store, and we don’t link to, review or promote add-ons made by others.
        </p>
      </details>
      <details>
        <summary>Is it free?</summary>
        <p>
          Yes. The code is open source, and the hosted web app at {site.appHost} will be free to
          use.
        </p>
      </details>
      <details>
        <summary>Do I need an account?</summary>
        <p>
          No. To continue on another device, pair it with a sync code. Skip that and everything
          stays on the one device.
        </p>
      </details>
      <details>
        <summary>Why isn’t it on Google Play?</summary>
        <p>
          We ship the .apk directly so releases don’t wait on store review. The app checks for
          updates itself, or you can follow releases with Obtainium.
        </p>
      </details>
      <details>
        <summary>Can I write my own add-on?</summary>
        <p>
          Yes. An add-on is a small HTTP service that returns JSON. The protocol and an SDK will be
          documented in the <a href={site.repoUrl}>repository</a>.
        </p>
      </details>
      <details>
        <summary>What does “{site.name}” mean?</summary>
        <p>
          It’s Indonesian for deep, peaceful sleep. It’s how we think a good story should end your
          day.
        </p>
      </details>
    </div>
  </section>

  <div class="band" id="rights">
    <section class="container section rights">
      <div class="rights-copy" data-reveal>
        <span class="eyebrow">For rights holders</span>
        <h2 class="h2 h2-small">Report copyright infringement</h2>
        <p class="lead">
          {site.name} is a player. We don’t host, index or link to audio, and our servers never
          carry it. If you believe something on our websites, in our repositories or in one of our
          own add-ons infringes your rights, tell us and we’ll act on it.
        </p>
      </div>
      <div class="card rights-card" data-reveal style="--i: 1">
        <a class="mono-accent email" href={`mailto:${site.copyrightEmail}`}>
          {site.copyrightEmail}
        </a>
        <p>Please include:</p>
        <ul>
          <li>The work you hold rights to</li>
          <li>Where you found the infringing material, with a link</li>
          <li>How to reach you, and that you are authorised to act for the rights holder</li>
        </ul>
        <p class="muted small">
          Add-ons made by others run on their own servers. We can’t remove them, but we’ll tell you
          what we know about where one is hosted.
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
    padding-block: clamp(40px, 7vw, 96px) clamp(56px, 8vw, 112px);
  }

  .hero-copy {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-visual {
    flex: 0 1 340px;
    margin-inline: auto;
  }

  /* Entrance on load; pure CSS, so the hero shows even if no script runs. */
  @media screen and (prefers-reduced-motion: no-preference) {
    .hero-copy > *,
    .hero-visual {
      animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .hero-copy > :nth-child(2) {
      animation-delay: 60ms;
    }

    .hero-copy > :nth-child(3) {
      animation-delay: 120ms;
    }

    .hero-copy > :nth-child(4) {
      animation-delay: 180ms;
    }

    .hero-copy > :nth-child(5) {
      animation-delay: 240ms;
    }

    .hero-visual {
      animation-duration: 1s;
      animation-delay: 200ms;
    }
  }

  .pill {
    align-self: flex-start;
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 13px;
    color: var(--fg-soft);
  }

  h1 {
    font-size: clamp(42px, 6.4vw, 80px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero-lead {
    max-width: 560px;
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--fg-soft);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .checks {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    font-size: 14px;
    color: var(--fg-soft);
  }

  .checks li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .checks :global(svg) {
    color: var(--accent);
  }

  .how {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px 56px;
  }

  .how-copy {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .nowrap {
    white-space: nowrap;
  }

  .how-visual {
    flex: 0 1 340px;
    margin-inline: auto;
  }

  .step {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .role {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--surface-2);
  }

  .role span {
    font-size: 13px;
    color: var(--muted);
    text-align: right;
  }

  .card .statement {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--fg);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 14px;
  }

  .chips-gap {
    margin-left: 12px;
  }

  .get-icon {
    color: var(--accent);
    display: flex;
  }

  .card .get-title {
