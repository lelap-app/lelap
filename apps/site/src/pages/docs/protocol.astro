const errorExample = `
HTTP/1.1 404 Not Found
Content-Type: application/json; charset=utf-8
Access-Control-Allow-Origin: *

{ "error": "Not found" }
`;

const headers = `
Content-Type: application/json; charset=utf-8
Access-Control-Allow-Origin: *
Access-Control-Allow-Methods: GET, POST, OPTIONS
Access-Control-Allow-Headers: *
Cache-Control: public, max-age=21600
`;

const schemaRef = `{ "$ref": "https://${site.domain}/docs/protocol.schema.json#/$defs/Manifest" }`;

const manifestFields: Field[] = [
  {
    name: 'id',
    type: 'string',
    required: true,
    meaning: 'Reverse DNS, such as `org.example.myaddon`; at least 3 characters. Keep it stable.',
  },
  {
    name: 'version',
    type: 'string',
    required: true,
    meaning: 'Your add-on’s semantic version, such as `1.2.0`.',
  },
  {
    name: 'protocol',
    type: `${PROTOCOL_VERSION}`,
    required: true,
    meaning: `The protocol version. Always \`${PROTOCOL_VERSION}\` for this reference.`,
  },
  { name: 'name', type: 'string', required: true, meaning: 'Shown to listeners. Not empty.' },
  {
    name: 'description',
    type: 'string',
    required: true,
    meaning: 'A sentence about what the add-on serves. May be empty.',
  },
  { name: 'logo', type: 'URL', required: false, meaning: 'An `http` or `https` image URL.' },
  {
    name: 'types',
    type: 'ContentType[]',
    required: true,
    meaning: 'The types you serve: `audiobook`, `podcast`, `episode`. At least one.',
  },
  {
    name: 'resources',
    type: '(ResourceName | Resource)[]',
    required: true,
    meaning:
      'What you answer: `catalog`, `meta`, `stream`, `scrobble`, each as a name or as a Resource object. At least one.',
  },
  {
    name: 'idPrefixes',
    type: 'string[]',
    required: false,
    meaning:
      'Prefixes of the IDs you answer `meta` and `stream` for, such as `example:`. Without it, any ID.',
  },
  {
    name: 'catalogs',
    type: 'CatalogDefinition[]',
    required: true,
    meaning: 'Your catalogs. Use `[]` when you have none.',
  },
  {
    name: 'protocolVersion',
    type: 'integer ≥ 1',
    required: false,
    meaning: `The revision of protocol ${PROTOCOL_VERSION} you write for; absent means 1. Revisions only add things. The newest is \`${LATEST_PROTOCOL_VERSION}\`.`,
  },
  {
    name: 'behaviorHints',
    type: 'BehaviorHints',
    required: false,
    meaning:
      'Revision 2. How the app should treat the add-on; see below. Unknown hints are ignored.',
  },
  {
    name: 'configurable',
    type: 'boolean',
    required: false,
    meaning:
      'The revision 1 spelling of `behaviorHints.configurable`. Send both if apps from before revision 2 should show Configure.',
  },
  {
    name: 'sandbox',
    type: '{ hosts: string[] }',
    required: false,
    meaning:
      'Revision 3, for add-ons inside the app only: the hosts the app fetches for it. See “Add-ons inside the app” below.',
  },
  {
    name: 'settings',
    type: 'SettingField[]',
    required: false,
    meaning:
      'Revision 5, for add-ons inside the app only: the form the app shows when the listener adds it as a server. See “Library sources” below.',
  },
];

const settingFields: Field[] = [
  {
    name: 'key',
    type: 'string',
    required: true,
    meaning: 'Where the value goes in `settings`: a letter, then letters, digits or `_`; up to 32.',
  },
  { name: 'label', type: 'string', required: true, meaning: 'The field’s name on the form.' },
  {
    name: 'type',
    type: '"text" | "url" | "password" | "signin"',
    required: true,
    meaning:
      '`url` takes an `http` or `https` address without a login in it; `password` is hidden as it is typed. `signin` (revision 7) is a button, not a field: the add-on’s sign-in fills it, and it is sealed like a password.',
  },
  {
    name: 'required',
    type: 'boolean',
    required: false,
    meaning: 'The form can’t be sent without it. Fields are optional otherwise.',
  },
  { name: 'placeholder', type: 'string', required: false, meaning: 'Shown in the empty field.' },
  { name: 'help', type: 'string', required: false, meaning: 'A short line under the field.' },
  {
    name: 'host',
    type: 'boolean',
    required: false,
    meaning:
      'For `url`: the add-on may reach the host of the address typed, for this server only, as if it were in `sandbox.hosts`.',
  },
];

const libraryFields: Field[] = [
  {
    name: 'path',
    type: 'string',
    required: true,
    meaning:
      'Folders and the file name with its extension, separated by `/`, such as `Author/Book/01.mp3`. No empty, `.` or `..` parts. A folder of audio files is a book, as on the phone.',
  },
  {
    name: 'url',
    type: 'URL',
    required: true,
    meaning:
      'The file, `http` or `https`, on one of the add-on’s hosts. Files elsewhere are left out.',
  },
  { name: 'size', type: 'integer ≥ 0', required: false, meaning: 'Bytes.' },
  {
    name: 'modifiedAt',
    type: 'integer',
    required: false,
    meaning:
