---
import {
  CatalogResponse,
  HealthResponse,
  LATEST_PROTOCOL_VERSION,
  Manifest,
  MetaResponse,
  PROTOCOL_VERSION,
  ScrobbleRequest,
  StreamResponse,
  catalogPath,
  metaPath,
  streamPath,
} from '@lelap/sdk';
import type { ZodType } from 'zod';
import CodeBlock from '../../components/CodeBlock.astro';
import FieldTable, { type Field } from '../../components/FieldTable.astro';
import Docs from '../../layouts/Docs.astro';
import { site } from '../../site';

const base = 'https://addon.example.com';

// The examples are checked against the SDK's schemas, so a protocol change breaks the build
// instead of leaving the docs wrong.
function example<T>(schema: ZodType<T>, value: T): string {
  schema.parse(value);
  return JSON.stringify(value, null, 2);
}

const manifest = example(Manifest, {
  id: 'com.example.readings',
  version: '1.0.0',
  protocol: 1,
  name: 'Example Readings',
  description: 'Public-domain books read by volunteers.',
  logo: `${base}/logo.png`,
  types: ['audiobook'],
  resources: ['catalog', 'meta', { name: 'stream', idPrefixes: ['example:', 'ol:'] }],
  idPrefixes: ['example:'],
  catalogs: [
    {
      type: 'audiobook',
      id: 'new',
      name: 'New releases',
      extra: [{ name: 'genre', options: ['children', 'mystery', 'poetry'] }, { name: 'skip' }],
    },
    {
      type: 'audiobook',
      id: 'search',
      name: 'Example Readings',
      extra: [{ name: 'search', isRequired: true }, { name: 'skip' }],
    },
  ],
});

const catalogUrl = `${base}/${catalogPath('audiobook', 'new', { skip: '20', genre: 'children' })}`;
const searchUrl = `${base}/${catalogPath('audiobook', 'search', { search: 'secret garden' })}`;
const catalog = example(CatalogResponse, {
  metas: [
    {
      id: 'example:secret-garden',
      type: 'audiobook',
      name: 'The Secret Garden',
      author: 'Frances Hodgson Burnett',
      cover: 'https://media.example.com/secret-garden/cover.jpg',
      year: 1911,
      durationMs: 27812000,
    },
    {
      id: 'example:wind-in-the-willows',
      type: 'audiobook',
      name: 'The Wind in the Willows',
      author: 'Kenneth Grahame',
      cover: 'https://media.example.com/wind-in-the-willows/cover.jpg',
      year: 1908,
    },
  ],
  cacheMaxAge: 21600,
});

const metaUrl = `${base}/${metaPath('audiobook', 'example:secret-garden')}`;
const meta = example(MetaResponse, {
  meta: {
    id: 'example:secret-garden',
    type: 'audiobook',
    name: 'The Secret Garden',
    author: 'Frances Hodgson Burnett',
    cover: 'https://media.example.com/secret-garden/cover.jpg',
    description: 'An orphan finds a locked garden and brings it back to life.',
    year: 1911,
    durationMs: 27812000,
    narrators: ['Ana Reader'],
    series: [{ name: 'Garden Stories', position: '1' }],
    language: 'en',
    genres: ['children', 'fiction'],
    chapters: [
      { title: 'There Is No One Left', startMs: 0 },
      { title: 'Mistress Mary Quite Contrary', startMs: 1123000 },
    ],
    externalIds: { ol: 'OL69612W' },
    link: 'https://example.com/books/secret-garden',
  },
  cacheMaxAge: 86400,
});

const podcastUrl = `${base}/${metaPath('podcast', 'example:night-sky')}`;
const podcast = example(MetaResponse, {
  meta: {
    id: 'example:night-sky',
    type: 'podcast',
    name: 'Night Sky Notes',
    author: 'Example Radio',
    cover: 'https://media.example.com/night-sky/cover.jpg',
    language: 'en',
    feed: 'https://media.example.com/night-sky/feed.xml',
    episodes: [
      {
        id: 'example:night-sky-12',
