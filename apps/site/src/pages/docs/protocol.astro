        durationMs: 1684000,
        description: 'Where to look this month, and what you can see without a telescope.',
      },
    ],
  },
});

const streamUrl = `${base}/${streamPath('audiobook', 'example:secret-garden')}`;
const streams = example(StreamResponse, {
  streams: [
    {
      sourceKey: 'secret-garden-ana',
      name: 'Example Readings',
      title: 'Read by Ana Reader',
      mime: 'audio/mpeg',
      bitrate: 64000,
      downloadable: true,
      parts: [
        {
          url: 'https://media.example.com/secret-garden/01.mp3',
          title: 'There Is No One Left',
          durationMs: 1123000,
          size: 8984000,
        },
        {
          url: 'https://media.example.com/secret-garden/02.mp3',
          title: 'Mistress Mary Quite Contrary',
          durationMs: 1342000,
          size: 10736000,
        },
      ],
    },
    {
      sourceKey: 'secret-garden-ben-m4b',
      name: 'Example Readings',
      title: 'Read by Ben Narrator, one file',
      mime: 'audio/mp4',
      size: 222496000,
      url: 'https://media.example.com/secret-garden/full.m4b',
      durationMs: 27812000,
      chapters: [
        { title: 'There Is No One Left', startMs: 0 },
        { title: 'Mistress Mary Quite Contrary', startMs: 1123000 },
      ],
    },
  ],
  cacheMaxAge: 86400,
});

const routes = `
GET /manifest.json                          → Manifest
GET /catalog/{type}/{id}.json               → { "metas": MetaPreview[] }
GET /catalog/{type}/{id}/{extra}.json       → { "metas": MetaPreview[] }
GET /meta/{type}/{id}.json                  → { "meta": Meta }
GET /stream/{type}/{id}.json                → { "streams": Stream[] }
POST /scrobble                              ← { "events": ScrobbleEvent[] }
GET /health                                 → HealthResponse      (revision 2)
GET /artwork/{type}/{id}.json               → { "artwork": ArtworkImage[] }  (revision 3)
GET /configure                              → your settings page  (HTML)
`;

const configuredManifest = example(Manifest, {
  id: 'com.example.readings',
  version: '1.1.0',
  protocol: 1,
  protocolVersion: 2,
  name: 'Example Readings',
  description: 'Public-domain books read by volunteers.',
  types: ['audiobook'],
  resources: ['catalog', 'meta', 'stream'],
  catalogs: [{ type: 'audiobook', id: 'new', name: 'New releases' }],
  configurable: true,
  behaviorHints: { configurable: true, configurationRequired: true, health: true },
});

const configureFlow = `
1. App opens   ${base}/configure?return=lelap%3A%2F%2Faddon
2. Listener    fills in the form, signs in if the add-on needs an account
3. Add-on      303 → lelap://addon?manifest=${encodeURIComponent(`${base}/e1.Q2lw…/manifest.json`)}
4. App         fetches that manifest, asks the listener, installs it or replaces the old URL
`;

const healthExample = example(HealthResponse, {
  status: 'degraded',
  message: 'Search is slow right now.',
});

const scrobbleExample = example(ScrobbleRequest, {
