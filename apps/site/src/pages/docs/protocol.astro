const routes = `
GET /manifest.json                          → Manifest
GET /catalog/{type}/{id}.json               → { "metas": MetaPreview[] }
GET /catalog/{type}/{id}/{extra}.json       → { "metas": MetaPreview[] }
GET /meta/{type}/{id}.json                  → { "meta": Meta }
GET /stream/{type}/{id}.json                → { "streams": Stream[] }
POST /scrobble                              ← { "events": ScrobbleEvent[] }
GET /health                                 → HealthResponse      (revision 2)
GET /artwork/{type}/{id}.json               → { "artwork": ArtworkImage[] }  (revision 3)
GET /library/audiobook/all.json             → { "files": LibraryFile[] }  (revision 5, inside the app)
place/audiobook/all.json                    ← PlaceReport          (revision 6, inside the app only)
signin/audiobook/start.json                 → SigninStart          (revision 7, inside the app only)
signin/audiobook/check.json                 → SigninResult         (revision 7, inside the app only)
scrobble/audiobook/all.json                 ← { events, settings } (revision 8, inside the app only)
GET /configure                              → your settings page  (HTML)
`;

