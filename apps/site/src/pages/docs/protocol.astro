];

const resourceFields: Field[] = [
  {
    name: 'name',
    type: '"catalog" | "meta" | "stream" | "scrobble"',
    required: true,
    meaning: 'The resource.',
  },
  {
    name: 'types',
    type: 'ContentType[]',
    required: false,
    meaning: 'The types this resource answers, if fewer than the manifest’s `types`.',
  },
  {
    name: 'idPrefixes',
    type: 'string[]',
    required: false,
