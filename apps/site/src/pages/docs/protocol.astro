  {
    name: 'durationMs',
    type: 'integer ≥ 0',
    required: false,
    meaning:
      'With it, the app takes `title`, `album`, `artist`, `albumArtist`, `chapters` and `ids` as they are; without it, it reads the tags from the file itself, and `title`, `album`, `artist`, `albumArtist` and `ids` fill in what the file lacks (a browser reads only the length).',
  },
  {
    name: 'album',
    type: 'string',
    required: false,
    meaning: 'The book’s title; `albumArtist` is its author.',
  },
  {
    name: 'ids',
    type: 'string[]',
    required: false,
    meaning:
      '`isbn:…`, `asin:…` and the like, so the app can show the book on its work’s page. Up to 16.',
  },
  {
    name: 'cover',
    type: 'URL',
    required: false,
    meaning:
      'A cover for the file’s book, on one of the add-on’s hosts, shown as it is. A `cover.jpg` in the folder works too, fetched with the headers and `query`.',
  },
  {
    name: 'downloadUrl',
    type: 'URL',
    required: false,
    meaning:
      'Revision 6: where the app downloads the file from, when not from `url`, on one of the add-on’s hosts.',
  },
  {
    name: 'place',
    type: 'object',
    required: false,
    meaning:
      'Revision 6: the listener’s place in this file as the server keeps it: `positionMs`, `at` (Unix time in milliseconds) and `played`. The newest place of a book wins, Lelap’s own or the server’s.',
  },
];

const behaviorFields: Field[] = [
  {
