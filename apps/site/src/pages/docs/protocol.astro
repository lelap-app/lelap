const configuredManifest = example(Manifest, {
  id: 'com.example.readings',
  version: '1.1.0',
  protocol: 1,
  protocolVersion: 2,
  name: 'Example Readings',
  description: 'Public-domain books read by volunteers.',
  types: ['audiobook'],
  resources: ['catalog', 'meta', 'stream'],
  catalogs: [{ type: 'audiobook', id: 'new', name: 'New releases' }],
  configurable: true,
  behaviorHints: { configurable: true, configurationRequired: true, health: true },
});

const configureFlow = `
1. App opens   ${base}/configure?return=lelap%3A%2F%2Faddon
2. Listener    fills in the form, signs in if the add-on needs an account
3. Add-on      303 → lelap://addon?manifest=${encodeURIComponent(`${base}/e1.Q2lw…/manifest.json`)}
4. App         fetches that manifest, asks the listener, installs it or replaces the old URL
`;

