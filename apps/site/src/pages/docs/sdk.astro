---
import { LATEST_PROTOCOL_VERSION } from '@lelap/sdk';
import CodeBlock from '../../components/CodeBlock.astro';
import Docs from '../../layouts/Docs.astro';
import { site } from '../../site';

const templateUrl = `${site.repoUrl}/tree/main/services/template`;
const sdkUrl = `${site.repoUrl}/tree/main/packages/sdk`;

const install = `
npm install @lelap/sdk hono
npm install --save-dev wrangler
`;

const worker = `
import { AddonError, createAddon, type Manifest, type MetaPreview } from '@lelap/sdk';
import { Hono } from 'hono';

const manifest: Manifest = {
  id: 'com.example.readings',
  version: '1.0.0',
  protocol: 1,
  name: 'Example Readings',
  description: 'Public-domain books read by volunteers.',
  types: ['audiobook'],
  resources: ['catalog', 'meta', 'stream'],
  idPrefixes: ['example:'],
  catalogs: [{ type: 'audiobook', id: 'new', name: 'New releases', extra: [{ name: 'skip' }] }],
};

// Your own data source: a database, a feed, an API you're allowed to use.
const books: MetaPreview[] = [
  {
    id: 'example:secret-garden',
    type: 'audiobook',
    name: 'The Secret Garden',
    author: 'Frances Hodgson Burnett',
    cover: 'https://media.example.com/secret-garden/cover.jpg',
  },
];

const PAGE = 50;

const addon = createAddon({
  manifest,

  catalog: ({ extra }) => {
    const skip = Number(extra.skip ?? 0);
    if (!Number.isInteger(skip) || skip < 0) throw new AddonError(400, 'skip must be a whole number');
    return { metas: books.slice(skip, skip + PAGE), cacheMaxAge: 6 * 3600 };
  },

  meta: ({ id }) => {
    const book = books.find((b) => b.id === id);
    if (!book) return null; // becomes a 404
    return {
      meta: { ...book, chapters: [{ title: 'There Is No One Left', startMs: 0 }] },
      cacheMaxAge: 86400,
    };
  },

  stream: ({ id }) => {
    if (id !== 'example:secret-garden') return { streams: [] };
    return {
      streams: [
        {
          sourceKey: 'secret-garden-ana',
          name: 'Example Readings',
          title: 'Read by Ana Reader',
          parts: [
            { url: 'https://media.example.com/secret-garden/01.mp3', durationMs: 1123000 },
            { url: 'https://media.example.com/secret-garden/02.mp3', durationMs: 1342000 },
          ],
        },
      ],
      cacheMaxAge: 86400,
    };
  },
});

const app = new Hono();
app.get('/', (c) => c.redirect('/manifest.json'));
app.all('*', (c) => addon.fetch(c.req.raw));

export default app;
`;

const wrangler = `
name = "example-readings"
main = "src/index.ts"
compatibility_date = "2026-11-01"
`;

const deploy = `
npx wrangler dev      # http://localhost:8787/manifest.json
npx wrangler deploy
`;

const deno = `
// main.ts: deno run --allow-net main.ts
Deno.serve(addon.fetch);
`;

const bun = `
// index.ts: bun run index.ts
export default { fetch: addon.fetch };
`;

const node = `
// Node, with @hono/node-server
import { serve } from '@hono/node-server';

serve({ fetch: addon.fetch, port: 8787 });
`;

const mounted = `
const librivox = createAddon(librivoxHandlers, { basePath: '/librivox' });
const catalog = createAddon(catalogHandlers);

const app = new Hono();
app.all('/librivox/*', (c) => librivox.fetch(c.req.raw));
app.all('*', (c) => catalog.fetch(c.req.raw));
`;

const errors = `
import { AddonError } from '@lelap/sdk';

catalog: async ({ extra }) => {
  if (!extra.search?.trim()) throw new AddonError(400, 'Type something to search for');
  const response = await fetch(upstreamSearchUrl(extra.search));
  if (response.status === 429)
    // Sent as Retry-After, so the app waits at least that long (SDK 0.5.0 and later).
    throw new AddonError(503, 'The source is busy, try again soon', { retryAfter: 60 });
  // …
},
`;

const onError = `
const addon = createAddon(handlers, {
  onError: (error, request) => console.error(request.url, error),
});
`;

const test = `
import { CatalogResponse } from '@lelap/sdk';
import { expect, test } from 'vitest';

import { addon } from './addon';

test('the catalog pages with skip', async () => {
  const response = await addon.fetch(
    new Request('https://addon.test/catalog/audiobook/new/skip=50.json'),
  );
  expect(response.status).toBe(200);
  expect(response.headers.get('Access-Control-Allow-Origin')).toBe('*');
  const body = CatalogResponse.parse(await response.json());
  expect(body.metas).toHaveLength(0);
});

test('unknown IDs are a 404', async () => {
  const response = await addon.fetch(
    new Request('https://addon.test/meta/audiobook/example%3Anope.json'),
  );
  expect(response.status).toBe(404);
});
`;

const configure = `
import { createAddon } from '@lelap/sdk';

export function makeAddon(env: { CONFIG_SECRET: string }) {
  return createAddon({
    manifest,
    configure: {
      // Encrypts the settings in the URL. Keep it in a Workers secret or an environment variable.
      secret: env.CONFIG_SECRET,
      // Web builds of the app that may receive the URL at <origin>/addon.
      returnOrigins: ['https://listen.example.org'],
      fields: [
        { key: 'user', label: 'Username', type: 'text', required: true },
        { key: 'password', label: 'Password', type: 'password', required: true },
        { key: 'language', label: 'Language', type: 'select', options: ['en', 'de', 'fr'] },
        { key: 'explicit', label: 'Show explicit episodes', type: 'checkbox' },
      ],
      // Sign in before the URL is made; a returned message shows on the form.
      check: async (config) => ((await signIn(config)) ? undefined : 'Wrong username or password.'),
    },
    catalog: async ({ config }) => ({ metas: await listFor(config) }),
  });
}
`;

const health = `
health: async () => {
  const response = await fetch(upstreamStatusUrl, { signal: AbortSignal.timeout(3000) });
  return response.ok ? { status: 'ok' } : { status: 'degraded', message: 'Search is slow' };
},
`;

const badges = `
catalog: async () => ({
  metas: books.map((book) => ({
    id: \`example:\${book.slug}\`,
    type: 'audiobook',
    name: book.title,
    cover: book.coverUrl,
    // Only with enough ratings to mean something.
    ...(book.ratings >= 3 ? { badges: { rating: book.averageRating } } : {}),
  })),
}),
`;

const toc: [string, string][] = [
  ['install', 'Install'],
  ['example', 'A complete add-on'],
  ['runtimes', 'Deno, Bun and Node'],
  ['options', 'Options'],
  ['configure', 'Settings and sign-in'],
  ['health', 'Health'],
  ['badges', 'Badges on covers'],
  ['library', 'Library sources inside the app'],
  ['errors', 'Errors'],
  ['validation', 'Validation'],
  ['testing', 'Testing'],
  ['app', 'Add it to the app'],
];
---

<Docs
  title="SDK guide"
  description={`Write a ${site.name} add-on in TypeScript with @lelap/sdk and run it on Cloudflare Workers, Deno, Bun or Node.`}
  toc={toc}
>
  <h1>SDK guide</h1>
  <p class="lead">
    <code>@lelap/sdk</code> has the protocol’s types and zod schemas, and <code>createAddon</code>,
    which turns a few handlers into a standard <code>fetch(request)</code> function with routing,
    CORS, caching headers and JSON errors done for you.
  </p>

  <h2 id="install">Install</h2>
  <p>
    The SDK is MIT-licensed, so you can use it in an add-on under any license. It needs a runtime
    with the Fetch API (<code>Request</code> and <code>Response</code>).
  </p>
  <CodeBlock code={install} label="Terminal" />
  <p>
    Or start from{' '}
    <a href={templateUrl}>
      <code>services/template</code>
    </a>
    , the smallest working add-on with the SDK wired in. The SDK’s source is in{' '}
    <a href={sdkUrl}>
      <code>packages/sdk</code>
    </a>
    .
  </p>

  <h2 id="example">A complete add-on</h2>
  <p>
    One catalog, meta and streams, served with <a href="https://hono.dev">Hono</a> on Cloudflare
    Workers. Every handler may be async.
  </p>
  <CodeBlock code={worker} label="src/index.ts" />
  <CodeBlock code={wrangler} label="wrangler.toml" />
  <CodeBlock code={deploy} label="Terminal" />
  <p>Handlers get:</p>
  <ul>
    <li>
      <code>catalog({'{ type, id, extra, request }'})</code>: <code>extra</code> is an object of
      strings, such as <code>{'{ search: "dune", skip: "20" }'}</code>. Return{' '}
      <code>{'{ metas, cacheMaxAge? }'}</code>.
    </li>
    <li>
      <code>meta({'{ type, id, request }'})</code>: return <code>{'{ meta, cacheMaxAge? }'}</code>,
      or <code>null</code> for an unknown ID.
    </li>
    <li>
      <code>stream({'{ type, id, request }'})</code>: return{' '}
      <code>{'{ streams, cacheMaxAge? }'}</code>; an empty list when you have nothing.
    </li>
  </ul>
  <p>
    IDs and extras arrive decoded. Leave out the handlers you don’t need and the resources you don’t
    declare; their routes answer <code>404</code>. The{' '}
    <a href="/docs/protocol/">protocol reference</a> has every field.
  </p>

  <h2 id="runtimes">Deno, Bun and Node</h2>
  <p>
    <code>addon.fetch</code> is a plain{' '}
    <code>(request: Request) =&gt; Promise&lt;Response&gt;</code>, so it runs without Hono too.
    Workers also take <code>export default {'{ fetch: addon.fetch }'}</code>.
  </p>
  <CodeBlock code={deno} label="Deno" />
  <CodeBlock code={bun} label="Bun" />
  <CodeBlock code={node} label="Node" />

  <h2 id="options">Options</h2>
  <p>
    <code>createAddon(handlers, options)</code> takes:
  </p>
  <ul>
    <li>
      <code>basePath</code>: the path the add-on is mounted under, such as <code>/librivox</code>.
      Defaults to the root. Requests outside it answer <code>404</code>.
    </li>
    <li>
      <code>validate</code>: check handler output against the protocol schemas. On by default.
    </li>
    <li>
      <code>onError(error, request)</code>: called with anything a handler throws, other than an{' '}
      <code>AddonError</code>, before the <code>500</code> goes out. Use it for logging.
    </li>
  </ul>
  <p>Several add-ons, each with its own manifest, can share one Worker:</p>
  <CodeBlock code={mounted} />
  <CodeBlock code={onError} />

  <h2 id="configure">Settings and sign-in</h2>
  <p>
    Give <code>createAddon</code> a <code>configure</code> option and the SDK serves a settings form
    at <code>/configure</code>, turns what the listener chose into a token in the add-on’s URL (
    <code>/e1.…/manifest.json</code>), sends them back to the app, and hands every handler the
    result as <code>config</code>. Nothing is stored on a server, yours or ours.
  </p>
  <CodeBlock code={configure} />
  <ul>
    <li>
      Fields are <code>text</code>, <code>password</code>, <code>select</code> (with{' '}
      <code>options</code>) and <code>checkbox</code>. Checkboxes arrive as booleans, the rest as
      strings; empty optional fields are left out.
    </li>
    <li>
      With <code>secret</code>, the token is encrypted with AES-GCM and only your add-on can read
      it; <code>password</code> fields need one. The next SDK version (0.6, not on npm yet) seals
      the manifest's <code>id</code> in too (<code>e2.…</code>), so of two add-ons sharing a secret,
      neither accepts the other's tokens; URLs with <code>e1.…</code> from earlier versions keep
      working. Without, the token is only encoded (<code>p1.…</code>), so anyone with the URL can
      read it. Changing the secret makes every configured URL unreadable; those requests answer{' '}
      <code>403</code>.
    </li>
    <li>
      With a required field, the bare manifest says <code>configurationRequired</code> and resources
      answer <code>403</code> until the listener configures it. The configured manifest leaves the
      hint out.
    </li>
    <li>
      Reopening Configure from the app shows the current settings, never the password, and an empty
      password keeps the old one.
    </li>
    <li>
      The page sends the URL back to <code>lelap://addon</code>, or to{' '}
      <code>https://{'{origin}'}/addon</code> for origins in <code>returnOrigins</code>. Otherwise
      it shows the URL to copy. The <a href="/docs/protocol/#configure">protocol reference</a>{' '}
      describes the flow for add-ons without the SDK.
    </li>
    <li>
      New in the next SDK release, 0.6, for a service with tokens and lists: <code>url</code> fields
      (http or https, without a login) and <code>choices</code> (a group of boxes, kept as a list of
      the ticked values), <code>placeholder</code>, and <code>text</code> with an <code>intro</code>
      , a <code>link</code>, numbered <code>steps</code> and a <code>note</code>.{' '}
      <code>choose</code> adds a second page whose fields depend on the first, such as the lists in
      the listener’s account; the first page’s settings ride along sealed for an hour, and Configure
      from a configured link opens it directly. <code>manifest(config)</code> gives each listener
      their own catalogs, and <code>legacy</code> keeps add-on addresses from before your add-on
      used this configure working. Throw an <code>AddonError</code> from <code>check</code> or{' '}
      <code>choose</code> to show its message on the page. The page after saving copies the address
      with a tap. With <code>text.signIn</code>, a button for signing in with the service comes
      first: it goes to a path on your add-on’s own host with the page’s return address added, and
      the form folds under it. It takes <code>href</code>, <code>label</code>, <code>note</code> and{' '}
      <code>other</code>. Lelap’s Hardcover and gPodder add-ons are built this way.
    </li>
    <li>
      The form and the page after it say who runs them: “This page is run by {'{host}'}, not by
      Lelap.” Lelap never appears as the sender, since the page asks for tokens and passwords. The
      pages use <code>PAGE_STYLE</code>, the stylesheet Lelap’s own configure pages use too, so
      listeners see one style; use it for pages of your own, as{' '}
      <a href="/docs/guide/#page-style">Your first add-on</a> shows. Both come with SDK 0.5.0.
    </li>
    <li>
      On Workers the secret arrives in <code>env</code> with each request, so build the add-on on
      the first one:{' '}
      <code>
        {'let addon; export default { fetch: (req, env) => (addon ??= makeAddon(env)).fetch(req) }'}
      </code>
      .
    </li>
  </ul>

  <h2 id="health">Health</h2>
  <p>
    Every SDK add-on answers <code>GET /health</code> with <code>{'{ "status": "ok" }'}</code> and
    declares <code>behaviorHints.health</code>; the SDK also sets <code>protocolVersion</code> to
    the newest revision it knows: 9 in SDK 0.5.0, the version on npm, and 8 in 0.4.0. The next
    release, 0.6, sets <code>{LATEST_PROTOCOL_VERSION}</code>. Pass a <code>health</code> handler to
    check what your add-on relies on. Keep it quick: the app asks when Settings → Library and
    sources → Add-ons opens.
  </p>
  <CodeBlock code={health} />

  <h2 id="badges">Badges on covers</h2>
  <p>
    To show a rating or a count of new episodes on a cover, send it as <code>badges</code> on the
    item, never as text in the picture. The app draws badges in one style next to its own (finished,
    how far in), reads them out with the title, and the listener can turn them off. Apps from before
    revision 4 ignore them. See <a href="/docs/protocol/#badges">Badges</a> for the fields. Badges
    need SDK 0.4.0 or later; 0.3.0 declares revision 3.
  </p>
  <CodeBlock code={badges} />

  <h2 id="library">Library sources inside the app</h2>
  <p>
    <code>createAddon</code> serves add-ons on the web. An add-on that lists the listener’s own
    files as a library, with a login, is a single JavaScript file that runs inside the app instead:
    see <a href="/docs/protocol/#library">Library sources</a>. The SDK still helps with it:{' '}
    <code>LibraryResponse</code> and <code>SettingField</code> check what it sends,{' '}
    <code>readSettings</code> checks a form as the app does, and <code>settingHosts</code> gives the
    hosts a form grants. A stream from <code>createAddon</code> never carries <code>headers</code>:
    the answer passes through the network, so the SDK refuses one that does, also with validation
    off. These helpers, revisions 5 to 8, need SDK 0.4.0 or later, like badges.
  </p>
  <p>
    Revision 9 comes with SDK 0.5.0; 0.4.0 stops at revision 8. Revision 9 adds <code>Edition</code>{' '}
    for a meta’s <code>editions</code>, <code>resumed</code> on a <code>ScrobbleEvent</code>,{' '}
    <code>next</code> on a <code>LibraryResponse</code> for a library in pages, and{' '}
    <code>setUpWithSettings(manifest)</code>, which tells whether an add-on inside the app is set up
    with its settings under Settings → Library and sources → Add-ons, its settings reaching every
    call. See <a href="/docs/protocol/#versions">Versions</a>.
  </p>
  <p>
    Revision 10 comes with the next SDK release, 0.6. A <code>scrobble</code> resource can list the{' '}
    <code>events</code> it uses, and <code>wantsScrobble(manifest, type, id, event)</code> tells
    whether an event reaches it. A <code>rate</code> without <code>rating</code> means the listener
    took their rating back, so a <code>scrobble</code> handler that keeps ratings should clear one
    then.
  </p>
  <p>
    Revision 11 comes with it too, for add-ons inside the app. A <code>LibraryResponse</code> can
    carry <code>settings</code>, new values for the add-on’s own fields, and the <code>locate</code>{' '}
    resource (<code>LocateRequest</code>, <code>LocateResponse</code>, <code>locatePath</code>,{' '}
    <code>offersLocate</code>) says where a book’s files stream from just before it plays. See{' '}
    <a href="/docs/protocol/#locate">Locating files</a>.
  </p>

  <h2 id="errors">Errors</h2>
  <p>
    Throw <code>new AddonError(status, message)</code> to answer with that status and{' '}
    <code>{'{ "error": message }'}</code>; <code>{'{ retryAfter: seconds }'}</code> as a third
    argument adds a <code>Retry-After</code> header. Anything else a handler throws becomes a{' '}
    <code>500</code>
    with <code>{'{ "error": "The add-on failed to answer" }'}</code>, so internal details never
    reach listeners.
  </p>
  <CodeBlock code={errors} />
  <p>The SDK answers these on its own, always as JSON with CORS headers:</p>
  <ul>
    <li>
      <code>204</code> for <code>OPTIONS</code> preflights.
    </li>
    <li>
      <code>405</code> for methods other than <code>GET</code>, <code>HEAD</code> and{' '}
      <code>OPTIONS</code>.
    </li>
    <li>
      <code>404</code> for unknown paths, resources or types the manifest doesn’t declare, catalogs
      it doesn’t list, missing handlers and <code>meta</code> returning <code>null</code>.
    </li>
  </ul>
  <p>
    The SDK doesn’t check <code>idPrefixes</code> on incoming requests; the app only sends IDs you
    declared, but answer unknown IDs with <code>null</code> or an empty list anyway.
  </p>

  <h2 id="validation">Validation</h2>
  <ul>
    <li>
      <code>createAddon</code> checks the manifest when it’s called and throws if it doesn’t match
      the protocol, so a broken manifest fails at startup, not in the app.
    </li>
    <li>
      With <code>validate</code> on, every catalog, meta and stream response is checked before it’s
      sent. Output that doesn’t match is a <code>500</code>, and <code>onError</code> gets the zod
      message naming the field. Fields the protocol doesn’t have are dropped.
    </li>
    <li>
      With <code>validate: false</code>, handler output is sent as it is. Turn it off only once your
      tests cover every handler.
    </li>
  </ul>
  <p>
    The schemas are exported too (<code>Manifest</code>, <code>CatalogResponse</code>,{' '}
    <code>MetaResponse</code>, <code>StreamResponse</code> and the objects inside them), and so are
    their types under the same names.
  </p>

  <h2 id="testing">Testing</h2>
  <p>
    <code>addon.fetch</code> needs no server: build a <code>Request</code>, await the{' '}
    <code>Response</code>. Keep <code>createAddon</code> in a module of its own, such as{' '}
    <code>src/addon.ts</code>, and import it from the Worker entry and from the tests. Remember that
    IDs in paths are percent-encoded. The SDK also exports <code>catalogPath</code>,{' '}
    <code>metaPath</code> and <code>streamPath</code>, which build paths the way the app does.
  </p>
  <CodeBlock code={test} label="src/addon.test.ts" />
  <p>
    For everything at once, <code>checkAddon</code> from <code>@lelap/sdk/check</code> runs the{' '}
    <a href="/docs/checking/">add-on test kit</a> against <code>addon.fetch</code>: schemas, CORS,
    caching, paging and IDs that come back. It comes with the next SDK release, 0.6.
  </p>

  <h2 id="app">Add it to the app</h2>
  <ol>
    <li>Deploy the add-on, or run it on a machine your phone can reach.</li>
    <li>
      In {site.name}, open <strong>Settings → Library and sources → Add-ons</strong>, paste the
      manifest URL, such as <code>https://addon.example.com/manifest.json</code>, and add it.
    </li>
    <li>
      Its catalogs show up on Home and in Discover, and searchable catalogs in Search. Items whose
      ID prefix it declares get its meta and streams.
    </li>
  </ol>
  <p>
    The web app needs HTTPS and the CORS headers the SDK sends. Keep your <code>sourceKey</code>
    values stable across versions; listeners’ saved places depend on them.
  </p>
</Docs>
