---
export type Field = {
  name: string;
  type: string;
  required: boolean;
  /** Plain text; wrap names in backticks to set them as code. */
  meaning: string;
};

interface Props {
  fields: Field[];
}

const { fields } = Astro.props;

// Splits `code` spans out of the description so it can stay a plain string in the page data.
const parts = (text: string) =>
  text.split('`').map((value, index) => ({ value, code: index % 2 === 1 }));
---

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Field</th>
        <th scope="col">Type</th>
        <th scope="col">Required</th>
        <th scope="col">Meaning</th>
      </tr>
    </thead>
    <tbody>
      {fields.map((field) => (
        <tr>
          <td>
            <code>{field.name}</code>
          </td>
          <td class="type">{field.type}</td>
          <td class={field.required ? 'req' : 'opt'}>{field.required ? 'yes' : 'no'}</td>
          <td>{parts(field.meaning).map((p) => (p.code ? <code>{p.value}</code> : p.value))}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  td:first-child code {
    color: var(--fg);
  }

  .type {
    font-family: var(--font-mono);
    font-size: 13.5px;
    min-width: 120px;
  }

  .req {
    color: var(--accent);
  }

  .opt {
    color: var(--muted);
  }
</style>
