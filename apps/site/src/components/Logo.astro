---
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<span class="logo" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg width={size * 0.56} height={size * 0.56} viewBox="0 0 24 24" fill="currentColor">
    <rect x="3" y="9" width="3" height="6" rx="1.5"></rect>
    <rect x="8" y="5" width="3" height="14" rx="1.5"></rect>
    <rect x="13" y="7" width="3" height="10" rx="1.5"></rect>
    <rect x="18" y="10" width="3" height="4" rx="1.5"></rect>
  </svg>
</span>

<style>
  .logo {
    border-radius: 28%;
    background: var(--accent-fill);
    color: var(--accent-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
</style>
