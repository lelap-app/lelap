---
// Lori, Lelap's mascot: a slow loris asleep with headphones on. The same drawing as the app's
// `apps/app/src/components/Lori.tsx`; inline SVG, so the page makes no extra requests.
interface Props {
  size?: number;
  class?: string;
}
const { size = 120, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  aria-hidden="true"
  focusable="false"
>
  <ellipse cx="52" cy="92" rx="36" ry="3.5" fill="#000" opacity="0.25"></ellipse>
  <ellipse cx="54" cy="70" rx="38" ry="22" fill="#a88a6a"></ellipse>
  <path
    d="M22 72c3 -13 22 -17 38 -13c13 3 26 2 32 10c-3 13 -19 19 -38 18c-19 0 -35 -4 -32 -15z"
    fill="#b79878"
  ></path>
  <circle cx="33" cy="38" r="5" fill="#8e7357"></circle>
  <circle cx="63" cy="38" r="5" fill="#8e7357"></circle>
  <ellipse cx="48" cy="53" rx="21" ry="19" fill="#c9ae8c"></ellipse>
  <ellipse cx="40" cy="52" rx="7.5" ry="8.5" fill="#3a2a20"></ellipse>
  <ellipse cx="56" cy="52" rx="7.5" ry="8.5" fill="#3a2a20"></ellipse>
  <path d="M46 35h4l-0.6 27h-2.8z" fill="#ede6d6"></path>
  <path
    d="M36 54q4 3 8 0M52 54q4 3 8 0"
    stroke="var(--accent)"
    stroke-width="1.6"
    stroke-linecap="round"
    fill="none"
  ></path>
  <ellipse cx="48" cy="63" rx="3" ry="2" fill="#3a2a20"></ellipse>
  <path
    d="M27 53a21 21 0 0 1 42 0"
    stroke="#22324f"
    stroke-width="4"
    stroke-linecap="round"
    fill="none"
  ></path>
  <rect x="22" y="47" width="8" height="14" rx="4" fill="var(--accent)"></rect>
  <rect x="66" y="47" width="8" height="14" rx="4" fill="var(--accent)"></rect>
  <path
    d="M76 32h6l-6 7h6"
    stroke="var(--accent)"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
    opacity="0.8"
  ></path>
</svg>
