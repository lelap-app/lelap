---
// The made-up hero book's drawn cover, the same drawing as the site-screenshots skill's
// (.claude/skills/site-screenshots/library.mjs), measured on its 600-unit square.
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** In dp. */
  size: number;
}

const { lang, size } = Astro.props;
---

<div class="cover" style={`--size: ${size}`}>
  <span class="author">Janet Tay</span>
  <span class="title">{t(lang, 'Early Mornings at the Laksa Café')}</span>
  <svg viewBox="0 0 120 96" fill="none" stroke-linecap="round">
    <circle cx="94" cy="20" r="11" fill="var(--cover-sand)" opacity="0.35"></circle>
    <path
      d="M44 30c-5-6 5-10 0-16M60 28c-5-6 5-10 0-16M76 30c-5-6 5-10 0-16"
      stroke="var(--cover-ink)"
      stroke-width="2.4"
      opacity="0.7"
    ></path>
    <path d="M78 6 52 46M90 10 60 47" stroke="var(--cover-sand)" stroke-width="3"></path>
    <path d="M14 48h92a46 40 0 0 1-92 0z" fill="var(--cover-paper)"></path>
    <path d="M18 48h84" stroke="var(--cover-broth)" stroke-width="7"></path>
    <path d="M44 92h32" stroke="var(--cover-paper)" stroke-width="5"></path>
  </svg>
</div>

<style>
  .cover {
    /* One unit of the 600-unit drawing. */
    --u: calc(var(--size) / 600 * var(--dp));
    position: relative;
    flex: none;
    width: calc(600 * var(--u));
    height: calc(600 * var(--u));
    padding: calc(48 * var(--u));
    border-radius: calc(6 * var(--dp));
    background: linear-gradient(170deg, var(--cover-teal) 55%, var(--cover-ocean));
    display: flex;
    flex-direction: column;
    gap: calc(26 * var(--u));
    overflow: hidden;
  }

  .author {
    font: 500 calc(26 * var(--u)) / 1 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cover-sand);
  }

  .title {
    max-width: calc(400 * var(--u));
    font: 600 calc(62 * var(--u)) / 1.02 var(--font-display);
    color: var(--cover-ink);
  }

  svg {
    position: absolute;
    right: calc(26 * var(--u));
    bottom: calc(26 * var(--u));
    width: calc(306 * var(--u));
  }
</style>
