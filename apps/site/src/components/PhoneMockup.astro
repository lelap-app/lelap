---
// The player, drawn after apps/app/src/components/PlayerView.tsx and Scrubber.tsx in dp. Compare
// with a reference shot from the site-screenshots skill after a change to the player.
import AppIcon from './AppIcon.astro';
import Icon from './Icon.astro';
import LaksaCover from './LaksaCover.astro';
import PhoneScreen from './PhoneScreen.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Chapter 3 is 20:35 long; 12:04 into it, as in the skill's demo library.
const played = (12 * 60 + 4) / (20 * 60 + 35);
const bookmarks = [0.21, 0.78];
---

<div class="stage night">
  <PhoneScreen
    label={t(
      lang,
      'Lelap’s player: Early Mornings at the Laksa Café by Janet Tay, chapter 3 of 6, at 1.25× speed, with a 30-minute sleep timer running.',
    )}
  >
    <div class="player">
      <div class="header">
        <span class="icon-button">
          <AppIcon name="down" size={26} />
        </span>
        <span class="of">{t(lang, 'Chapter {n} of {total}', { n: 3, total: 6 })}</span>
        <span class="icon-button"></span>
      </div>
      <div class="cover-area">
        <LaksaCover lang={lang} size={280} />
      </div>
      <div class="details">
        <div class="names">
          <span class="book">{t(lang, 'Early Mornings at the Laksa Café')}</span>
          <span class="chapter">{t(lang, 'Chapter {n}', { n: 3 })}</span>
        </div>
        <span class="bookmark-add">
          <AppIcon name="bookmarkAdd" size={22} />
        </span>
      </div>
      <div class="scrubber">
        <div class="bar" style={`--played: ${played}`}>
          <span class="track">
            <span class="fill"></span>
          </span>
          {bookmarks.map((at) => (
            <span class="mark" style={`--at: ${at}`} />
          ))}
          <span class="thumb"></span>
        </div>
        <div class="times">
          <span class="elapsed">12:04</span>
          <span class="middle">
            {t(lang, 'Book {percent}% · {m} min left', { percent: 42, m: 59 })}
          </span>
          <span>-8:31</span>
        </div>
      </div>
      <div class="controls">
        <span class="control">
          <AppIcon name="skipBack" size={34} />
        </span>
        <span class="control">
          <AppIcon name="previous" size={26} />
        </span>
        <span class="play">
          <AppIcon name="pause" size={32} />
        </span>
        <span class="control">
          <AppIcon name="next" size={26} />
        </span>
        <span class="control">
          <AppIcon name="skipForward" size={34} />
        </span>
      </div>
      <div class="tools">
        <span class="tool">
          <AppIcon name="speed" size={22} />
          1.25×
        </span>
        <span class="tool">
          <AppIcon name="sound" size={22} />
          {t(lang, 'Sound')}
        </span>
        <span class="tool active">
          <AppIcon name="moon" size={22} />
          29:56
        </span>
        <span class="tool">
          <AppIcon name="chapters" size={22} />
          {t(lang, 'Chapters')}
        </span>
        <span class="tool">
          <AppIcon name="bookmark" size={22} />
          {t(lang, '{n} bookmarks', { n: 2 })}
        </span>
      </div>
    </div>
  </PhoneScreen>
  <div class="float" aria-hidden="true">
    <Icon name="circleCheck" size={20} />
    <span class="float-text">
      <b>{t(lang, 'Downloaded')}</b>
      <span>{t(lang, 'Ready for airplane mode')}</span>
    </span>
  </div>
</div>

<style>
  .stage {
    position: relative;
    width: 340px;
    max-width: 100%;
    margin-inline: auto;
    display: flex;
    justify-content: flex-end;
  }

  /* PlayerView: 24 dp on the sides, 4 dp under the status bar, 12 dp above the gesture bar. */
  .player {
    flex: 1;
    min-height: 0;
    padding: calc(4 * var(--dp)) calc(24 * var(--dp)) calc(12 * var(--dp));
    display: flex;
    flex-direction: column;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .icon-button {
    width: calc(48 * var(--dp));
    height: calc(48 * var(--dp));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .of {
    flex: 1;
    text-align: center;
    font-size: calc(12 * var(--dp));
    line-height: calc(16 * var(--dp));
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--app-muted);
  }

  .cover-area {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .details {
    padding-bottom: calc(16 * var(--dp));
    display: flex;
    align-items: center;
    gap: calc(12 * var(--dp));
  }

  .names {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--dp));
  }

  .book {
    font-size: calc(20 * var(--dp));
    line-height: calc(28 * var(--dp));
    font-weight: 600;
  }

  .chapter {
    min-height: calc(48 * var(--dp));
    display: flex;
    align-items: center;
    color: var(--app-soft);
  }

  .bookmark-add {
    flex: none;
    width: calc(48 * var(--dp));
    height: calc(48 * var(--dp));
    border-radius: 50%;
    background: var(--app-raised);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scrubber {
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--dp));
  }

  .bar {
    position: relative;
    height: calc(48 * var(--dp));
    display: flex;
    align-items: center;
  }

  .track {
    width: 100%;
    height: calc(6 * var(--dp));
    border-radius: 999px;
    background: var(--app-line);
    overflow: hidden;
  }

  .fill {
    display: block;
    width: calc(var(--played) * 100%);
    height: 100%;
    background: var(--app-amber);
  }

  /* Bookmarks are amber dots above the bar. */
  .mark {
    position: absolute;
    left: calc(var(--at) * 100% - 4 * var(--dp));
    top: calc(8 * var(--dp));
    width: calc(8 * var(--dp));
    height: calc(8 * var(--dp));
    border-radius: 50%;
    background: var(--app-amber);
  }

  .thumb {
    position: absolute;
    left: calc(var(--played) * 100% - 8 * var(--dp));
    width: calc(16 * var(--dp));
    height: calc(16 * var(--dp));
    border-radius: 50%;
    background: var(--app-paper);
  }

  .times {
    min-height: calc(48 * var(--dp));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(8 * var(--dp));
    font-size: calc(14 * var(--dp));
    line-height: calc(20 * var(--dp));
    color: var(--app-muted);
  }

  .elapsed {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .middle {
    font-size: calc(12 * var(--dp));
    line-height: calc(16 * var(--dp));
    text-align: center;
  }

  .controls {
    padding-block: calc(16 * var(--dp));
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .control {
    width: calc(56 * var(--dp));
    height: calc(56 * var(--dp));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play {
    width: calc(80 * var(--dp));
    height: calc(80 * var(--dp));
    border-radius: 50%;
    background: var(--app-amber);
    color: var(--app-ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tools {
    display: flex;
  }

  .tool {
    flex: 1;
    min-width: 0;
    padding-block: calc(8 * var(--dp));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(4 * var(--dp));
    font-size: calc(12 * var(--dp));
    line-height: calc(16 * var(--dp));
    font-weight: 600;
    color: var(--app-soft);
    white-space: nowrap;
  }

  .tool.active {
    color: var(--app-amber);
  }

  .float {
    position: absolute;
    left: 0;
    top: 44%;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--surface-float);
    border: 1px solid var(--line-strong);
    box-shadow: 0 12px 32px var(--shadow);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }

  .float :global(svg) {
    flex: none;
    color: var(--accent);
  }

  .float-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .float-text span {
    color: var(--muted);
    font-size: 12px;
  }

  /* On the narrowest phones the note would cover the drawing; the picture says enough. */
  @media (max-width: 360px) {
    .float {
      display: none;
    }
  }
</style>
