---
// The home page, one source for every language; pages/index.astro and pages/ms/index.astro wrap it.
import Base from '../layouts/Base.astro';
import Icon, { type IconName } from './Icon.astro';
import Lori from './Lori.astro';
import CatalogMockup from './CatalogMockup.astro';
import PhoneMockup from './PhoneMockup.astro';
import { site } from '../site';
import { html, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Links to English-only pages carry hreflang on pages in other languages.
const english = lang === 'en' ? undefined : 'en';

const features: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'moon',
    title: t(lang, 'A sleep timer that fades'),
    text: t(
      lang,
      'Minutes or end of chapter. Fades out over the last minute, rewinds a little so you can find your place, and a shake buys you ten more.',
    ),
  },
  {
    icon: 'plane',
    title: t(lang, 'Offline first'),
    text: t(
      lang,
      'Download books and episodes over Wi-Fi with the screen off, on Android to an SD card if you like. Airplane mode is a normal day, not an error state.',
    ),
  },
  {
    icon: 'cloud',
    title: t(lang, 'Your server, your bucket'),
    text: t(
      lang,
      'Play straight from your WebDAV, S3-compatible, Jellyfin, Emby, Plex, Navidrome or Audiobookshelf server, and on Android from SMB and SFTP. The app talks to it directly and keeps the credentials on your device.',
    ),
  },
  {
    icon: 'call',
    title: t(lang, 'Keeps going through calls'),
    text: t(
      lang,
      'Lower the volume instead of stopping when a call comes in. Your choice, on Android.',
    ),
  },
  {
    icon: 'sync',
    title: t(lang, 'Progress that follows you'),
    text: t(
      lang,
      'Pick up on your laptop where you stopped on your phone. Pair devices with a code; sync is end-to-end encrypted.',
    ),
  },
  {
    icon: 'gauge',
    title: t(lang, 'Smart rewind, speed, chapters'),
    text: t(
      lang,
      'Rewinds further the longer you paused. Speed per book with pitch correction and chapter-aware scrubbing.',
    ),
  },
  {
    icon: 'wave',
    title: t(lang, 'Clearer voices'),
    text: t(
      lang,
      'Voice boost brings soft and loud words closer together. On Android, skip silence shortens long pauses and shows the time it saved, and even loudness keeps every book at one level. Set per book or per show.',
    ),
  },
  {
    icon: 'list',
    title: t(lang, 'Playlists, tags and Up Next'),
    text: t(
      lang,
      'The library opens in three groups: in progress, not started and finished. One queue for books and episodes, hand-made lists, and smart ones like “short and not started” or “for the flight”. Hide what you don’t want in the library; files that look like music are pointed out.',
    ),
  },
  {
    icon: 'chart',
    title: t(lang, 'Your year in sound'),
    text: t(
      lang,
      'Time listened today, this week and this year, your streaks and the books you finished. Share your year as an image, made on your phone.',
    ),
  },
  {
    icon: 'cast',
    title: t(lang, 'Cast to the living room'),
    text: t(
      lang,
      'Sonos, DLNA, Google Cast and FCast from Android. The lock screen, your headphones and the sleep timer control the speaker.',
    ),
  },
  {
    icon: 'car',
    title: t(lang, 'Made for the car'),
    text: t(
      lang,
      'Car mode shows a large cover and five big buttons. Android Auto shows the covers saved on your phone.',
    ),
  },
  {
    icon: 'folder',
    title: t(lang, 'Bring your own files'),
    text: t(
      lang,
      'Import m4b, mp3, opus and flac, or point it at a folder. Chapters come from the tags, covers from the tags or an image beside the audio, and a book you own plays from its catalog page. OPML in and out for podcasts.',
    ),
  },
  {
    icon: 'books',
    title: t(lang, 'Chapters where there were none'),
    text: t(
      lang,
      'On Android, finds chapters at the long silences of a book without any. Skips a show’s intro and outro, set once per show.',
    ),
  },
  {
    icon: 'screens',
    title: t(lang, 'Phone, tablet or laptop'),
    text: t(
      lang,
      'On a wide screen the player stands beside your library. The web app has keyboard shortcuts for play, skip and speed.',
    ),
  },
  {
    icon: 'access',
    title: t(lang, 'Works with a screen reader'),
    text: t(
      lang,
      'Every control has a name for TalkBack, buttons are large enough to hit, and screens hold up at the largest text size.',
    ),
  },
];

const bare = (url: string) => url.replace(/^https?:\/\//, '');

// Before the first beta nothing links to an APK, not even through GitHub or Obtainium.
const shipped = site.released || site.beta;

const channels: {
  icon: IconName;
  title: string;
  where?: string;
  /** Where tapping the address goes. */
  whereHref?: string | undefined;
  text: string;
  link?: { href: string; label: string; primary?: boolean };
  later?: boolean;
}[] = [
  {
    icon: 'download',
    title: t(lang, 'Direct download'),
    where: site.downloadsHost,
    text: t(
      lang,
      'The signed APK from our own downloads host. Once installed, the app checks for updates itself.',
    ),
    link: { href: site.apkUrl, label: t(lang, 'Download .apk'), primary: true },
  },
  {
    icon: 'tag',
    title: 'GitHub Releases',
    where: bare(site.releasesUrl),
    whereHref: shipped ? site.releasesUrl : undefined,
    text: t(lang, 'Every version with its release notes, the same APKs and build attestations.'),
  },
  {
    icon: 'sync',
    title: 'Obtainium',
    where: bare(site.repoUrl),
    // Obtainium opens `obtainium://add/<url>` with the repository filled in.
    whereHref: shipped ? `obtainium://add/${site.repoUrl}` : undefined,
    text: site.beta
      ? t(
          lang,
          'Add the repository URL in Obtainium and it installs new versions from GitHub Releases. While Lelap is in beta, turn on “Include prereleases” for it.',
        )
      : t(
          lang,
          'Add the repository URL in Obtainium and it installs new versions from GitHub Releases.',
        ),
  },
  {
    icon: 'grid',
    title: 'F-Droid',
    text: t(
      lang,
      'Coming after the first stable release. F-Droid builds Lelap from source and, when the result matches ours, ships the same signed APK, so you can switch between F-Droid and the direct download without reinstalling.',
    ),
    later: true,
  },
];

const addonRoles = [
  [t(lang, 'Catalogs'), t(lang, 'Trending, new, your shelves')],
  [t(lang, 'Metadata'), t(lang, 'Covers, narrators, chapters')],
  [t(lang, 'Sources'), t(lang, 'Where the audio file lives')],
  [t(lang, 'Scrobble'), t(lang, 'Share progress elsewhere')],
];

const services = [
  ['web', t(lang, 'The PWA, served as static files.')],
  [
    'catalog',
    t(lang, 'The built-in catalog add-on: Open Library, LibriVox and Podcast Index, cached.'),
  ],
  ['proxy', t(lang, 'Fetches RSS feeds and cover images for the web app. Never audio.')],
  ['sync', t(lang, 'Stores encrypted progress and playlists. It can’t read them.')],
];

const compose = `services:
  web:
    image: ghcr.io/lelap-app/web
    ports: ["8080:8080"]
  catalog:
    image: ghcr.io/lelap-app/catalog
    env_file: .env
  proxy:
    image: ghcr.io/lelap-app/proxy
  sync:
    image: ghcr.io/lelap-app/sync
    volumes: ["./data:/data"]`;
---

<Base lang={lang} home>
  <section class="container hero">
    <div class="hero-copy">
      <span class="pill">
        {site.released
          ? t(lang, 'Open source · Android · Web · Self-hosted')
          : site.beta
            ? t(lang, 'Open source · Beta · Android and web')
            : t(lang, 'In development · Open source · Android and web')}
      </span>
      <h1>{t(lang, site.tagline)}</h1>
      <p class="hero-lead">
        {t(
          lang,
          'Connect the libraries you already have through add-ons, download for the flight, and drift off to a timer that fades. Open source, no account, no app store, no lock-in.',
        )}
      </p>
      <div class="cta">
        {site.released ? (
          <>
            <a class="btn btn-lg btn-primary" href={site.appUrl}>
              {t(lang, 'Open {host}', { host: site.appHost })}
            </a>
            <a class="btn btn-lg btn-outline" href={site.apkUrl}>
              <Icon name="download" size={18} strokeWidth={2} />
              {t(lang, 'Download for Android')}
            </a>
            <a class="btn-link" href="#selfhost">
              {t(lang, 'Self-host with Docker →')}
            </a>
          </>
        ) : (
          <>
            {site.beta && (
              <a class="btn btn-lg btn-primary" href={site.betaApkUrl}>
                <Icon name="download" size={18} strokeWidth={2} />
                {t(lang, 'Try the Android beta')}
              </a>
            )}
            <a
              class:list={['btn btn-lg', site.beta ? 'btn-outline cta-more' : 'btn-primary']}
              href={site.repoUrl}
            >
              <Icon name="code" size={18} strokeWidth={2} />
              {t(lang, 'Follow on GitHub')}
            </a>
            <a
              class:list={['btn btn-lg btn-outline', site.beta && 'cta-more']}
              href={site.briefUrl}
              hreflang={english}
            >
              {t(lang, 'Read the plan')}
            </a>
          </>
        )}
      </div>
      <ul class="checks">
        <li>
          <Icon name="check" size={18} strokeWidth={2} />
          {t(lang, 'Works fully offline')}
        </li>
        <li>
          <Icon name="check" size={18} strokeWidth={2} />
          {t(lang, 'No account needed')}
        </li>
        <li>
          <Icon name="check" size={18} strokeWidth={2} />
          {t(lang, 'Audio never passes through our servers')}
        </li>
      </ul>
    </div>
    <div class="hero-visual">
      <PhoneMockup lang={lang} />
    </div>
  </section>

  <div class="band" id="how">
    <section class="container section">
      <div class="how">
        <div class="how-copy" data-reveal>
          <div class="section-head">
            <span class="eyebrow">{t(lang, 'How it works')}</span>
            <h2
              class="h2"
              set:html={html(
                lang,
                'The app plays. <span class="nowrap">Add-ons</span> bring the library.',
              )}
            />
            <p class="lead">
              {t(
                lang,
                '{name} handles playback, downloads, progress and sync. What you browse, where the audio lives and where your progress is shared are add-ons you choose, made and run by whoever builds them.',
                { name: site.name },
              )}
            </p>
          </div>
          <div class="chips">
            <span class="muted">{t(lang, 'Ships with open sources:')}</span>
            <span class="chip">LibriVox</span>
            <span class="chip">Open Library</span>
            <span class="chip">Podcast Index</span>
            <span class="chip">{t(lang, 'RSS feeds')}</span>
            <span class="chip">{t(lang, 'Your own files')}</span>
            <span class="muted chips-gap">{t(lang, 'Optional:')}</span>
            <span class="chip chip-dashed">Audiobookshelf</span>
            <span class="chip chip-dashed">WebDAV</span>
            <span class="chip chip-dashed">Internet Archive</span>
            <span class="chip chip-dashed">Hardcover</span>
            <span class="chip chip-dashed">gPodder</span>
          </div>
        </div>
        <div class="how-visual" data-reveal style="--i: 1">
          <CatalogMockup lang={lang} />
        </div>
      </div>
      <div class="grid">
        <div class="card" data-reveal>
          <span class="step">{t(lang, '1 · Add-ons answer')}</span>
          <div class="roles">
            {addonRoles.map(([name, text]) => (
              <div class="role">
                <b>{name}</b>
                <span>{text}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="card" data-reveal style="--i: 1">
          <span class="step">{t(lang, '2 · Your device keeps it')}</span>
          <p class="statement">
            {t(lang, 'Library, progress, downloads and playlists live on your phone first.')}
          </p>
          <p>
            {t(
              lang,
              'Add-ons can be slow, offline or gone tomorrow. What you downloaded keeps playing, and your progress never depends on someone else’s server.',
            )}
          </p>
        </div>
        <div class="card" data-reveal style="--i: 2">
          <span class="step">{t(lang, '3 · Install by URL')}</span>
          <pre class="code"><code>{`GET /manifest.json
{
  "id": "org.librivox",
  "resources": ["catalog", "meta", "stream"],
  "types": ["audiobook"]
}`}</code></pre>
          <p
            set:html={html(
              lang,
              'Paste an add-on’s address and you’re done. Settings live on the add-on’s own page; the app only remembers the URL. <a href="/docs/" hreflang="en">Build your own</a>.',
            )}
          />
        </div>
      </div>
    </section>
  </div>

  <section class="container section" id="features">
    <div class="features-head" data-reveal>
      <div class="section-head">
        <span class="eyebrow">{t(lang, 'Features')}</span>
        <h2 class="h2">{t(lang, 'Built for long listens.')}</h2>
      </div>
      <figure class="lori">
        {/* A details toggle, so Lori says hello without any script, and works from a keyboard. */}
        <details class="lori-hello">
          <summary aria-label={t(lang, 'Say hello to Lori')}>
            <Lori size={128} class="lori-art" />
          </summary>
          <p
            class="lori-bubble"
            set:html={html(
              lang,
              'Hi, I’m Lori, a slow loris. <em>Lelap</em> is Indonesian for deep, peaceful sleep, which I’m very good at. I’m from Indonesia too, and I keep your place while you drift off.',
            )}
          />
        </details>
        <figcaption>{t(lang, 'Lori, asleep before the chapter ends. Tap him.')}</figcaption>
      </figure>
    </div>
    <div class="grid">
      {features.map((f, i) => (
        <div class="card card-outline" data-reveal style={`--i: ${i % 3}`}>
          <span class="icon-tile">
            <Icon name={f.icon} />
          </span>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="band" id="get">
    <section class="container section">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{t(lang, 'Download')}</span>
        <h2 class="h2">{t(lang, 'Get it on Android, or open it in a browser.')}</h2>
        <p class="lead">
          {site.released
            ? t(lang, 'No Play Store and no account. Every channel ships the same signed APK.')
            : site.beta
              ? t(
                  lang,
                  'A beta for Android is out: a test version, with rough edges. It updates itself as new betas arrive.',
                )
              : t(
                  lang,
                  'Nothing to download yet. These are the ways you’ll get the first version.',
                )}
        </p>
      </div>
      <div class="download">
        <div class="card android" data-reveal>
          <div class="android-head">
            <span class="get-icon">
              <Icon name="phone" size={28} strokeWidth={1.6} />
            </span>
            <div class="android-title">
              <h3 class="get-title">Android</h3>
              <span class="mono-accent">{t(lang, '.apk · Android 8.0 or newer')}</span>
            </div>
            {!site.released && (
              <span class="badge">{site.beta ? t(lang, 'Beta') : t(lang, 'Coming soon')}</span>
            )}
          </div>
          <p>
            {t(
              lang,
              'The full experience: background playback, downloads with the screen off, casting and Android Auto. Small updates install themselves; new versions take one tap.',
            )}
          </p>
          <ul class="channels">
            {channels.map((c) => (
              <li class="channel">
                <span class="icon-tile">
                  <Icon name={c.icon} />
                </span>
                <div class="channel-copy">
                  <strong>{c.title}</strong>
                  {c.where &&
                    (c.whereHref ? (
                      <a class="channel-where" href={c.whereHref}>
                        <code>{c.where}</code>
                      </a>
                    ) : (
                      <code class="channel-where">{c.where}</code>
                    ))}
                  <p>{c.text}</p>
                  {c.link?.primary && (site.released || site.beta) && (
                    <a class="channel-alt" href={site.beta ? site.betaApk32Url : site.apk32Url}>
                      {t(lang, 'Older phone with a 32-bit processor? Get the 32-bit .apk')}
                    </a>
                  )}
                </div>
                {c.later ? (
                  <span class="badge channel-end">{t(lang, 'Later')}</span>
                ) : (
                  (site.released || (site.beta && c.link?.primary)) &&
                  c.link && (
                    <a
                      class:list={[
                        'btn btn-sm channel-end',
                        c.link.primary ? 'btn-primary' : 'btn-outline',
                      ]}
                      href={site.beta && c.link.primary ? site.betaApkUrl : c.link.href}
                    >
                      {c.link.primary && <Icon name="download" size={18} strokeWidth={2} />}
                      {site.beta && c.link.primary ? t(lang, 'Download beta .apk') : c.link.label}
                    </a>
                  )
                )}
              </li>
            ))}
          </ul>
          <div class="verify">
            <Icon name="shield" size={22} />
            {site.released ? (
              <p
                set:html={html(
                  lang,
                  '<b>Checking the file?</b> <a href="{info}">latest.json</a> lists the version, size and SHA-256 of the current APKs, 64-bit and 32-bit, and each GitHub release carries the same files with a build attestation and a <code>SHA256SUMS</code> list. Compare with <code>sha256sum</code>, or run <code>gh attestation verify</code> against the repository.',
                  { info: site.releaseInfoUrl },
                )}
              />
            ) : site.beta ? (
              <p
                set:html={html(
                  lang,
                  '<b>Checking the file?</b> <a href="{info}">beta.json</a> lists the version, size and SHA-256 of the current beta APKs, 64-bit and 32-bit, and each GitHub pre-release carries the same files with a build attestation.',
                  { info: site.betaInfoUrl },
                )}
              />
            ) : (
              <p
                set:html={html(
                  lang,
                  '<b>For people who verify:</b> each release will publish the APK’s SHA-256 in <code>latest.json</code> on {host} and on GitHub, with a build attestation, so you can check the file before you install it.',
                  { host: site.downloadsHost },
                )}
              />
            )}
          </div>
        </div>
        <div class="side">
          <div class="card get" data-reveal style="--i: 1">
            <span class="get-icon">
              <Icon name="globe" size={28} strokeWidth={1.6} />
            </span>
            <h3 class="get-title">{t(lang, 'Web app')}</h3>
            <span class="mono-accent">{site.appHost}</span>
            <p>
              {t(
                lang,
                'Nothing to install. Add it to your home screen as a PWA. Best for your laptop, an iPhone or iPad, or any device that isn’t an Android phone.',
              )}
            </p>
            {site.released ? (
              <a class="btn btn-primary get-cta" href={site.appUrl}>
                {t(lang, 'Start listening')}
              </a>
            ) : (
              <span class="badge get-cta">{t(lang, 'Coming soon')}</span>
            )}
          </div>
          <div class="card get" data-reveal style="--i: 2">
            <span class="get-icon">
              <Icon name="box" size={28} strokeWidth={1.6} />
            </span>
            <h3 class="get-title">{t(lang, 'Self-hosted')}</h3>
            <span class="mono-accent">docker compose up</span>
            <p>
              {t(
                lang,
                'Run the web app, catalog, feed proxy and sync on your own machine, and point the Android app at it.',
              )}
            </p>
            <a class="btn btn-outline get-cta" href="#selfhost">
              {t(lang, 'Self-hosting')}
            </a>
          </div>
        </div>
      </div>
      <p class="muted small">
        {t(
          lang,
          'No iOS app is planned. iPhone and iPad can use the web app, with streaming and in-app downloads.',
        )}
      </p>
    </section>
  </div>

  <section class="container section selfhost" id="selfhost">
    <div class="selfhost-copy" data-reveal>
      <span class="eyebrow">{t(lang, 'Self-host')}</span>
      <h2 class="h2">{t(lang, 'Run the whole thing yourself.')}</h2>
      <p class="lead">
        {t(
          lang,
          'Everything behind {host} is in the repository. Four small containers; sync keeps one SQLite file, so there is no database server to run.',
          { host: site.appHost },
        )}
      </p>
      <ul class="services">
        {services.map(([name, text]) => (
          <li>
            <span class="mono-accent">{name}</span>
            <span>{text}</span>
          </li>
        ))}
      </ul>
      {!site.released && (
        <p
          class="muted small"
          set:html={html(
            lang,
            'Until the first stable release, use the <code>beta</code> tag of each image.',
          )}
        />
      )}
    </div>
    <div class="terminal" data-reveal style="--i: 1">
      <div class="terminal-head">docker-compose.yml</div>
      <pre class="terminal-body"><code>{compose}</code></pre>
      <div class="terminal-foot">
        <span>$</span> docker compose up -d
      </div>
    </div>
  </section>

  <div class="band">
    <section class="container section">
      <h2 class="h2 narrow" data-reveal>
        {t(lang, 'Nothing to look at, by design.')}
      </h2>
      <div class="grid promises">
        <div data-reveal>
          <h3>{t(lang, 'No account')}</h3>
          <p>{t(lang, 'Your library lives on your device. There is no profile to sign up for.')}</p>
        </div>
        <div data-reveal style="--i: 1">
          <h3>{t(lang, 'Encrypted sync')}</h3>
          <p>
            {t(
              lang,
              'Devices pair with a code. The sync server only ever sees ciphertext. Lost a phone? Reset sync from another device and its key opens nothing new.',
            )}
          </p>
        </div>
        <div data-reveal style="--i: 2">
          <h3>{t(lang, 'No audio through us')}</h3>
          <p>
            {t(
              lang,
              'Your phone talks to add-ons and their sources directly. We never see what you play.',
            )}
          </p>
        </div>
        <div data-reveal style="--i: 3">
          <h3>{t(lang, 'No ads, no tracking')}</h3>
          <p>{t(lang, 'Open source, so you can check every line of that claim.')}</p>
        </div>
      </div>
    </section>
  </div>

  <section class="container section faq" id="faq">
    <h2 class="h2" data-reveal>
      {t(lang, 'Questions')}
    </h2>
    <div data-reveal style="--i: 1">
      {!site.released && (
        <details open>
          <summary>{t(lang, 'When can I use it?')}</summary>
          <p>
            {site.beta
              ? t(
                  lang,
                  'A beta for Android is out now. The first stable version follows after a round of testing on phones; the roadmap is in the open on GitHub.',
                )
              : t(
                  lang,
                  '{name} is in early development. Follow the repository on GitHub to see progress; the plan and the roadmap are in the open.',
                  { name: site.name },
                )}
          </p>
        </details>
      )}
      <details open={site.released}>
        <summary>{t(lang, 'Where does the audio come from?')}</summary>
        <p>
          {t(
            lang,
            'From the add-ons you install. Out of the box that means public-domain audiobooks from LibriVox, podcast feeds and your own files. Add-ons are made and run by third parties. You are responsible for the add-ons you add and for only playing content you have the right to.',
          )}
        </p>
      </details>
      <details>
        <summary>
          {t(lang, 'Does {name} list or recommend third-party add-ons?', { name: site.name })}
        </summary>
        <p>
          {t(
            lang,
