---
// Home, drawn after apps/app/app/(tabs)/index.tsx, ContinueCard.tsx, CatalogRow.tsx and
// MetaCard.tsx in dp. Compare with a reference shot from the site-screenshots skill after a change.
import AppIcon from './AppIcon.astro';
import Icon from './Icon.astro';
import LaksaCover from './LaksaCover.astro';
import PhoneScreen from './PhoneScreen.astro';
import { site } from '../site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

interface Book {
  title: string;
  author: string;
  art: string;
}

const c = (name: string) => `var(--cover-${name})`;
const amber = 'var(--app-amber)';

// Small drawn scenes on a 60×60 canvas.
const birdSpots: [number, number][] = [
  [12, 14],
  [19, 10],
  [16, 21],
  [25, 17],
  [9, 26],
  [22, 27],
];
const birds = birdSpots
  .map(([x, y]) => `<path d="M${x - 3} ${y}q1.5-2 3 0q1.5-2 3 0" stroke="${c('ink-dark')}"/>`)
  .join('');

const weeks = Array.from({ length: 81 }, (_, i) => {
  const x = 8 + (i % 9) * 5.5;
  const y = 8 + Math.floor(i / 9) * 5.5;
  const lived = i < 34;
  return `<circle cx="${x}" cy="${y}" r="1.6" fill="${lived ? amber : c('paper')}" opacity="${lived ? 1 : 0.3}"/>`;
}).join('');

const habits = [1, 1, 2, 3, 5, 8]
  .flatMap((count, col) =>
    Array.from({ length: count }, (_, k) => {
      const top = col === 5 && k === count - 1;
      return `<rect x="${12 + col * 6.4}" y="${50 - (k + 1) * 5.2}" width="4.2" height="4.2" rx="0.6" fill="${top ? amber : c('navy')}"/>`;
    }),
  )
  .join('');

const wreath = Array.from({ length: 9 }, (_, i) => {
  const a = ((110 + i * 17) * Math.PI) / 180;
  const x = 30 + 17 * Math.cos(a);
  const y = 30 + 17 * Math.sin(a);
  const r = (110 + i * 17 + 90) % 360;
  return `<ellipse cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" rx="3.4" ry="1.5" transform="rotate(${r} ${x.toFixed(1)} ${y.toFixed(1)})"/><ellipse cx="${(60 - x).toFixed(1)}" cy="${y.toFixed(1)}" rx="3.4" ry="1.5" transform="rotate(${-r} ${(60 - x).toFixed(1)} ${y.toFixed(1)})"/>`;
}).join('');

const batSpots: [number, number, number][] = [
  [14, 14, 1],
  [24, 9, 0.8],
  [44, 22, 0.9],
  [35, 15, 0.7],
];
const bats = batSpots
  .map(
    ([x, y, k]) =>
      `<path transform="translate(${x} ${y}) scale(${k})" d="M0 0q-3-3-7-1 2 0 2 2-2 0-3 2 3-1 5 0 1-2 3-1 2-1 3 1 2-1 5 0-1-2-3-2 0-2 2-2-4-2-7 1z"/>`,
  )
  .join('');

const garland = Array.from({ length: 7 }, (_, i) => {
  const x = 6 + i * 8;
  const y = 12 + Math.sin((i / 6) * Math.PI) * 9;
  return `<circle cx="${x}" cy="${y.toFixed(1)}" r="3" fill="${i % 2 ? c('broth') : amber}"/>`;
}).join('');

const art = {
  atomic: `<rect width="60" height="60" fill="${c('paper')}"/>${habits}
    <path d="M10 51h40" stroke="${c('navy')}" stroke-width="1"/>`,
  weeks: `<rect width="60" height="60" fill="${c('ocean')}"/>${weeks}`,
  courage: `<rect width="60" height="60" fill="${c('wine')}"/>
    <g fill="none" stroke-width="1.4" stroke-linecap="round">${birds}
    <path d="M38 22q2.5-3.5 5 0q2.5-3.5 5 0" stroke="${amber}" stroke-width="2"/></g>
    <path d="M0 46h60v14H0z" fill="${c('plum')}"/>
    <path d="M30 46v-9" stroke="${c('ink-dark')}" stroke-width="1.4"/>
    <circle cx="30" cy="35" r="1.6" fill="${c('ink-dark')}"/>`,
  meditations: `<rect width="60" height="60" fill="${c('slate')}"/>
    <g fill="${c('sand')}">${wreath}</g>
    <circle cx="30" cy="30" r="5" fill="${amber}"/>`,
  apple: `<rect width="60" height="60" fill="${c('ink-dark')}"/>
    <path d="M30 22c-8-5-18 0-17 11 1 10 8 17 13 16 2 0 3-1 4-1s2 1 4 1c5 1 12-6 13-16 1-11-9-16-17-11z" fill="${c('wine')}"/>
    <path d="M30 22c0-4 2-7 5-8" stroke="${c('olive')}" stroke-width="1.6" fill="none"/>
    <path d="M42 6L24 40l2 1L44 7z" fill="${c('paper')}"/><path d="M24 40l-3 6 4-4z" fill="${c('ink-dark')}"/>
    <path d="M27 36c0 4-1 8-1 12M28.5 37c.5 3 .5 6 0 8" stroke="${c('broth')}" stroke-width="1.2" fill="none"/>`,
  wound: `<rect width="60" height="60" fill="${c('forest')}"/>
    <circle cx="30" cy="18" r="9" fill="${c('sand')}" opacity="0.9"/>
    <path d="M0 60V36c6-4 10-2 14-6 2 6 6 6 8 2 3 5 8 5 11 0 3 4 7 4 9-1 4 4 8 3 12 1 3 2 4 3 6 4v24z" fill="${c('ink-dark')}"/>
    <path d="M26 52c0-8 2-14 4-16 2 2 4 8 4 16z" fill="${c('paper')}" opacity="0.85"/>
    <circle cx="30" cy="34" r="2.4" fill="${c('paper')}" opacity="0.85"/>
    <path d="M44 42h2v10h-2zM46 44l4-2" stroke="${c('rose')}" stroke-width="1" fill="${c('rose')}"/>`,
  gothic: `<rect width="60" height="60" fill="${c('plum')}"/>
    <path d="M14 52V24l16-12 16 12v28z" fill="${c('ink-dark')}"/>
    <path d="M22 30h4v6h-4zM34 30h4v6h-4z" fill="${amber}" opacity="0.85"/><path d="M27 52V42a3 3 0 0 1 6 0v10z" fill="${c('slate')}"/>
    <g fill="${c('sand')}" opacity="0.8"><circle cx="8" cy="50" r="3"/><circle cx="11" cy="46" r="2"/><circle cx="50" cy="48" r="3"/><circle cx="53" cy="52" r="2.2"/><circle cx="47" cy="53" r="1.8"/></g>
    <path d="M0 54h60v6H0z" fill="${c('forest')}"/>`,
  strange: `<rect width="60" height="60" fill="${c('paper')}"/>
    <g fill="none" stroke="${c('navy')}" stroke-width="1.6" stroke-linecap="square">
      <rect x="9" y="11" width="42" height="38"/>
      <path d="M9 29h12M25 29h2M27 11v12M27 27v22M40 34h11M27 34h7M37 11v23M40 34v15"/>
    </g>
    <path d="M37 22h3v12h-3z" fill="${c('rose')}"/>`,
  batEater: `<rect width="60" height="60" fill="${c('ink-dark')}"/>
    <circle cx="44" cy="13" r="7" fill="${c('sand')}" opacity="0.85"/>
    <g fill="${c('plum')}">${bats}</g>
    <path d="M0 60V38h8v-6h6v10h6V30h8v12h5v-8h9v10h6v-6h8v6h4v16z" fill="${c('plum')}"/>
    <path d="M23 34h2v3h-2zM38 38h2v3h-2zM10 36h2v3h-2z" fill="${amber}" opacity="0.8"/>
    <rect x="28" y="44" width="4" height="6" rx="2" fill="${c('broth')}"/>
    <path d="M30 42v2" stroke="${c('broth')}" stroke-width="0.8"/>`,
  inherit: `<rect width="60" height="60" fill="${c('sand')}"/>
    <path d="M0 4q30 18 60 0" stroke="${c('olive')}" stroke-width="1" fill="none"/>${garland}
    <path d="M18 60V40a12 12 0 0 1 24 0v20z" fill="${c('wine')}"/>
    <path d="M22 60V41a8 8 0 0 1 16 0v19z" fill="${c('ink-dark')}" opacity="0.55"/>
    <path d="M27 54c0-3 6-3 6 0z" fill="${amber}"/><path d="M30 51c-1 1-1 2 0 3 1-1 1-2 0-3z" fill="${c('broth')}"/>`,
  flies: `<rect width="60" height="60" fill="${c('ocean')}"/>
    <circle cx="14" cy="13" r="6" fill="${amber}" opacity="0.9"/>
    <path d="M4 40c6-9 16-12 26-12s20 3 26 12z" fill="${c('forest')}"/>
    <path d="M36 30c1-6 4-9 8-10M44 20c-3 0-6 1-8 3M44 20c-1 3-1 5 0 7" stroke="${c('olive')}" stroke-width="1.6" fill="none"/>
    <path d="M0 40h60v20H0z" fill="${c('sand')}" opacity="0.9"/>
    <path d="M18 50c0-5 6-8 13-6 4 1 6 4 4 6z" fill="${c('paper')}"/>
    <path d="M21 49c2-3 6-4 10-3M24 50c2-2 5-2 8-1" stroke="${c('rose')}" stroke-width="0.9" fill="none"/>
    <path d="M45 42c-2 3 1 4 0 6 2-1 3-3 1-6zM42 47h7" stroke="${c('broth')}" stroke-width="1.2" fill="${amber}"/>`,
} as const;

// Real titles, our own drawings: never the publishers' cover art. A list shows metadata only; the
// audio comes from a source the listener has, such as their own library.
const rows: { name: string; books: Book[] }[] = [
  {
    name: t(lang, 'Self-improvement'),
    books: [
      { title: 'Atomic Habits', author: 'James Clear', art: art.atomic },
      { title: 'Four Thousand Weeks', author: 'Oliver Burkeman', art: art.weeks },
      { title: 'The Courage to Be Disliked', author: 'Ichiro Kishimi', art: art.courage },
      { title: 'Meditations', author: 'Marcus Aurelius', art: art.meditations },
    ],
  },
  {
    name: t(lang, 'Growing up'),
    books: [
      {
        title: 'Bat Eater and Other Names for Cora Zeng',
        author: 'Kylie Lee Baker',
        art: art.batEater,
      },
      {
        title: 'What We Inherit: Growing Up Indian',
        author: 'Various authors',
        art: art.inherit,
      },
      { title: 'Lord of the Flies', author: 'William Golding', art: art.flies },
    ],
  },
  {
    name: t(lang, 'Horror and uncanny'),
    books: [
      { title: 'Strange Houses', author: 'Uketsu', art: art.strange },
      { title: 'Apple and Knife', author: 'Intan Paramaditha', art: art.apple },
      { title: 'Mexican Gothic', author: 'Silvia Moreno-Garcia', art: art.gothic },
      { title: 'Beauty Is a Wound', author: 'Eka Kurniawan', art: art.wound },
    ],
  },
];

const tabs = [
  { icon: 'home', label: t(lang, 'Home') },
  { icon: 'discover', label: t(lang, 'Discover') },
  { icon: 'search', label: t(lang, 'Search') },
  { icon: 'podcast', label: t(lang, 'Podcasts') },
  { icon: 'library', label: t(lang, 'Library') },
] as const;
---

<div class="stage night">
  <PhoneScreen
    raisedBar
    label={t(
      lang,
      'Lelap’s home screen: the book to continue at the top, then rows of books from an add-on: Self-improvement and Growing up.',
    )}
  >
    <div class="scroll">
      <div class="head">
        <span class="lelap">{site.name}</span>
        <span class="head-end">
          <span class="pill">
            <span class="dot"></span>
            {t(lang, '1 add-on')}
          </span>
          <span class="icon-button">
            <AppIcon name="stats" />
          </span>
          <span class="icon-button">
            <AppIcon name="settings" />
          </span>
        </span>
      </div>
      <div class="continue">
        <LaksaCover lang={lang} size={72} />
        <span class="continue-text">
          <span class="eyebrow">{t(lang, 'Continue listening')}</span>
          <span class="continue-title">{t(lang, 'Early Mornings at the Laksa Café')}</span>
          <span class="soft">{t(lang, 'Chapter {n}', { n: 3 })}</span>
          <span class="soft">{t(lang, '{h} h {m} min left', { h: 1, m: 14 })}</span>
        </span>
        <span class="play">
          <AppIcon name="play" size={22} />
        </span>
      </div>
      {rows.map((row) => (
        <section class="row">
          <div class="row-head">
            <span class="row-name">{row.name}</span>
            <span class="more">
              {t(lang, 'More')}
              <AppIcon name="forward" size={16} />
            </span>
          </div>
          <div class="shelf">
            {row.books.map((book) => (
              <div class="tile">
                <div class="tile-cover">
                  <svg viewBox="0 0 60 60" set:html={book.art} />
                  <span class="badge">{t(lang, 'Metadata only')}</span>
                </div>
                <span class="tile-title">{book.title}</span>
                <span class="tile-author">{book.author}</span>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
    <div class="mini">
      <span class="mini-progress"></span>
      <div class="mini-row">
        <span class="mini-text">
          <span class="mini-title">{t(lang, 'Early Mornings at the Laksa Café')}</span>
          <span class="mini-chapter">{t(lang, 'Chapter {n}', { n: 3 })}</span>
        </span>
        <span class="play">
          <AppIcon name="play" size={20} />
        </span>
      </div>
    </div>
    <div class="tabs">
      {tabs.map((tab, i) => (
        <span class:list={['tab', { active: i === 0 }]}>
          <AppIcon name={tab.icon} />
          {tab.label}
        </span>
      ))}
    </div>
  </PhoneScreen>
  <div class="float" aria-hidden="true">
    <Icon name="box" size={18} />
    <b>{t(lang, 'Rows come from your add-ons')}</b>
  </div>
</div>

<style>
  .stage {
    position: relative;
    width: 340px;
    max-width: 100%;
    margin-inline: auto;
  }

  /* Home: a scroll view, 12 dp under the status bar and 24 dp between its parts. */
  .scroll {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    padding-top: calc(12 * var(--dp));
    display: flex;
    flex-direction: column;
    gap: calc(24 * var(--dp));
  }

  .head {
    padding-inline: calc(16 * var(--dp));
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .lelap {
    font-size: calc(30 * var(--dp));
    line-height: calc(36 * var(--dp));
    font-weight: 600;
  }

  .head-end {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--dp));
    color: var(--app-soft);
  }

  .pill {
    padding: calc(8 * var(--dp)) calc(12 * var(--dp));
    border: calc(1 * var(--dp)) solid var(--app-line);
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: calc(6 * var(--dp));
    font-size: calc(12 * var(--dp));
    line-height: calc(16 * var(--dp));
    white-space: nowrap;
  }

  .dot {
    width: calc(6 * var(--dp));
    height: calc(6 * var(--dp));
    border-radius: 50%;
    background: var(--app-ok);
  }

  .icon-button {
    width: calc(48 * var(--dp));
    height: calc(48 * var(--dp));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ContinueCard */
  .continue {
    margin-inline: calc(16 * var(--dp));
    padding: calc(12 * var(--dp));
    border-radius: calc(12 * var(--dp));
    background: var(--app-raised);
    display: flex;
    align-items: center;
    gap: calc(16 * var(--dp));
  }

  .continue-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--dp));
    font-size: calc(14 * var(--dp));
    line-height: calc(20 * var(--dp));
  }

  .eyebrow {
    font-size: calc(12 * var(--dp));
    line-height: calc(16 * var(--dp));
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--app-muted);
  }

  .continue-title {
    font-size: calc(16 * var(--dp));
    line-height: calc(24 * var(--dp));
    font-weight: 600;
  }

  .soft {
    color: var(--app-soft);
  }

  .play {
    flex: none;
    width: calc(48 * var(--dp));
    height: calc(48 * var(--dp));
    border-radius: 50%;
    background: var(--app-amber);
    color: var(--app-ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* CatalogRow and MetaTile: 120 dp covers, 12 dp apart. */
  .row {
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--dp));
  }

  .row-head {
    min-height: calc(48 * var(--dp));
    padding-inline: calc(16 * var(--dp));
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .row-name {
    font-size: calc(18 * var(--dp));
    line-height: calc(28 * var(--dp));
    font-weight: 600;
  }

  .more {
    display: flex;
    align-items: center;
    font-size: calc(14 * var(--dp));
    color: var(--app-amber);
  }

  .shelf {
    padding-inline: calc(16 * var(--dp));
    display: flex;
    gap: calc(12 * var(--dp));
  }

  .tile {
    flex: 0 0 calc(120 * var(--dp));
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--dp));
  }

  .tile-cover {
    position: relative;
    height: calc(120 * var(--dp));
    border-radius: calc(6 * var(--dp));
    overflow: hidden;
  }

  .tile-cover svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .badge {
    position: absolute;
    left: calc(6 * var(--dp));
    bottom: calc(6 * var(--dp));
    padding: calc(1 * var(--dp)) calc(6 * var(--dp));
    border: calc(1 * var(--dp)) solid var(--app-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--app-night) 85%, transparent);
    font-size: calc(10 * var(--dp));
    line-height: calc(14 * var(--dp));
    font-weight: 600;
    color: var(--app-muted);
    white-space: nowrap;
  }

  .tile-title {
    font-size: calc(14 * var(--dp));
    line-height: calc(20 * var(--dp));
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .tile-author {
    font-size: calc(12 * var(--dp));
    line-height: calc(16 * var(--dp));
    color: var(--app-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* MiniPlayer above the tab bar. */
  .mini {
    flex: none;
    padding-bottom: calc(8 * var(--dp));
    border-top: calc(1 * var(--dp)) solid var(--app-line);
    background: var(--app-raised);
  }

  .mini-progress {
    display: block;
    height: calc(2 * var(--dp));
    background: linear-gradient(to right, var(--app-amber) 59%, var(--app-line) 59%);
  }

  .mini-row {
    padding: calc(8 * var(--dp)) calc(16 * var(--dp)) 0;
    display: flex;
    align-items: center;
    gap: calc(12 * var(--dp));
  }

  .mini-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    white-space: nowrap;
  }

  .mini-title {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini-chapter {
    font-size: calc(14 * var(--dp));
    line-height: calc(20 * var(--dp));
    color: var(--app-muted);
  }

  /* React Navigation's tab bar: 49 dp, labels under the icons. */
  .tabs {
    flex: none;
    height: calc(49 * var(--dp));
    border-top: calc(1 * var(--dp)) solid var(--app-line);
    background: var(--app-raised);
    display: flex;
  }

  .tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(2 * var(--dp));
    font-size: calc(10 * var(--dp));
    line-height: calc(12 * var(--dp));
    font-weight: 500;
    color: var(--app-muted);
  }

  .tab.active {
    color: var(--app-amber);
  }

  .float {
    position: absolute;
    right: 0;
    top: 60%;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--surface-float);
    border: 1px solid var(--line-strong);
    box-shadow: 0 12px 32px var(--shadow);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }

  .float :global(svg) {
    flex: none;
    color: var(--accent);
  }

  /* On the narrowest phones the note would cover the drawing; the picture says enough. */
  @media (max-width: 360px) {
    .float {
      display: none;
    }
  }
</style>
