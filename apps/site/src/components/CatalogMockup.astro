---
import Icon from './Icon.astro';

interface Book {
  title: string;
  art: string;
  progress?: number;
}

const c = (name: string) => `var(--cover-${name})`;
const amber = 'var(--accent)';

// Small drawn scenes on a 60×60 canvas.
const birdSpots: [number, number][] = [
  [12, 14],
  [19, 10],
  [16, 21],
  [25, 17],
  [9, 26],
  [22, 27],
];
const birds = birdSpots
  .map(([x, y]) => `<path d="M${x - 3} ${y}q1.5-2 3 0q1.5-2 3 0" stroke="${c('ink-dark')}"/>`)
  .join('');

const weeks = Array.from({ length: 81 }, (_, i) => {
  const x = 8 + (i % 9) * 5.5;
  const y = 8 + Math.floor(i / 9) * 5.5;
  const lived = i < 34;
  return `<circle cx="${x}" cy="${y}" r="1.6" fill="${lived ? amber : c('paper')}" opacity="${lived ? 1 : 0.3}"/>`;
}).join('');

const habits = [1, 1, 2, 3, 5, 8]
  .flatMap((count, col) =>
    Array.from({ length: count }, (_, k) => {
      const top = col === 5 && k === count - 1;
      return `<rect x="${12 + col * 6.4}" y="${50 - (k + 1) * 5.2}" width="4.2" height="4.2" rx="0.6" fill="${top ? amber : c('navy')}"/>`;
    }),
  )
  .join('');

const wreath = Array.from({ length: 9 }, (_, i) => {
  const a = ((110 + i * 17) * Math.PI) / 180;
  const x = 30 + 17 * Math.cos(a);
  const y = 30 + 17 * Math.sin(a);
  const r = (110 + i * 17 + 90) % 360;
  return `<ellipse cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" rx="3.4" ry="1.5" transform="rotate(${r} ${x.toFixed(1)} ${y.toFixed(1)})"/><ellipse cx="${(60 - x).toFixed(1)}" cy="${y.toFixed(1)}" rx="3.4" ry="1.5" transform="rotate(${-r} ${(60 - x).toFixed(1)} ${y.toFixed(1)})"/>`;
}).join('');

const art = {
  pride: `<rect width="60" height="60" fill="${c('rose')}"/>
    <circle cx="46" cy="14" r="6" fill="${c('sand')}" opacity="0.45"/>
    <path d="M6 41V31h10v-5l14-7 14 7v5h10v10z" fill="${c('plum')}"/>
    <path d="M9 33h2.4v4H9zM20 30h2.4v4H20zM26 30h2.4v4H26zM32 30h2.4v4H32zM38 30h2.4v4H38zM49 33h2.4v4H49z" fill="${amber}"/>
    <rect y="41" width="60" height="19" fill="${c('wine')}"/>
    <path d="M21.5 56l3-8.5 3 8.5z" fill="${c('paper')}"/><circle cx="24.5" cy="45.6" r="1.7" fill="${c('paper')}"/>
    <path d="M33 47.5h3.4V56H33z" fill="${c('ink-dark')}"/><circle cx="34.7" cy="45.8" r="1.5" fill="${c('ink-dark')}"/>
    <path d="M33.6 41.6h2.2v2.6h-2.2zM32.8 44.1h3.8" stroke="${c('ink-dark')}" stroke-width="0.8" fill="${c('ink-dark')}"/>`,
  moby: `<rect width="60" height="60" fill="${c('navy')}"/>
    <path d="M27 43c0-8 1-12 2-15-4 0-11-2-16-8 7 2 13 1 17 4 4-3 10-2 17-4-5 6-12 8-16 8 1 3 2 7 2 15z" fill="${c('paper')}"/>
    <path d="M0 42c5-3 10-3 15 0s10 3 15 0 10-3 15 0 10 3 15 0V60H0z" fill="${c('ocean')}"/>
    <path d="M18 47c4-2 8-2 12 0s8 2 12 0" stroke="${c('paper')}" stroke-width="1.2" fill="none" opacity="0.5"/>
    <path d="M5 37h11l-2 3H7z" fill="${c('ink-dark')}"/><path d="M10 37v-8" stroke="${c('ink-dark')}" stroke-width="1"/>`,
  jane: `<rect width="60" height="60" fill="${c('navy')}"/>
    <circle cx="47" cy="12" r="5" fill="${c('paper')}" opacity="0.8"/>
    <path d="M6 52V32l10-7 10 7v-6h22v26z" fill="${c('ink-dark')}"/>
    <path d="M11 37h3v4h-3zM19 37h3v4h-3zM30 36h3v4h-3zM41 36h3v4h-3z" fill="${c('slate')}"/>
    <path d="M35 29h5v-4h-5z" fill="${amber}"/>
    <path d="M37.5 18c-3 3-1 5-2.5 7h5c-1-2 1-3-1-5 0 1.5-.8 2-1.5 1 .8-1 .5-2 0-3z" fill="${amber}"/>
    <rect y="52" width="60" height="8" fill="${c('plum')}"/>
    <path d="M17 58l1.6-5h1.8l1.6 5z" fill="${c('rose')}"/><circle cx="19.5" cy="51.5" r="1.3" fill="${c('rose')}"/>`,
  frankenstein: `<rect width="60" height="60" fill="${c('slate')}"/>
    <path d="M37 3l-9 19h7l-6 16 15-22h-7l6-13z" fill="${amber}"/>
    <path d="M0 50l12-8 10 5 12-9 12 7 14-6V60H0z" fill="${c('paper')}" opacity="0.25"/>
    <path d="M9 60V30h4v-4h3v4h4v-4h3v4h4v30z" fill="${c('ink-dark')}"/>
    <path d="M16 38h3v4h-3z" fill="${amber}"/>`,
  atomic: `<rect width="60" height="60" fill="${c('paper')}"/>${habits}
    <path d="M10 51h40" stroke="${c('navy')}" stroke-width="1"/>`,
  weeks: `<rect width="60" height="60" fill="${c('ocean')}"/>${weeks}`,
  courage: `<rect width="60" height="60" fill="${c('wine')}"/>
    <g fill="none" stroke-width="1.4" stroke-linecap="round">${birds}
    <path d="M38 22q2.5-3.5 5 0q2.5-3.5 5 0" stroke="${amber}" stroke-width="2"/></g>
    <path d="M0 46h60v14H0z" fill="${c('plum')}"/>
    <path d="M30 46v-9" stroke="${c('ink-dark')}" stroke-width="1.4"/>
    <circle cx="30" cy="35" r="1.6" fill="${c('ink-dark')}"/>`,
  meditations: `<rect width="60" height="60" fill="${c('slate')}"/>
    <g fill="${c('sand')}">${wreath}</g>
    <circle cx="30" cy="30" r="5" fill="${amber}"/>`,
  strange: `<rect width="60" height="60" fill="${c('paper')}"/>
    <g fill="none" stroke="${c('navy')}" stroke-width="1.6" stroke-linecap="square">
      <rect x="9" y="11" width="42" height="38"/>
      <path d="M9 29h12M25 29h2M27 11v12M27 27v22M40 34h11M27 34h7M37 11v23M40 34v15"/>
    </g>
    <path d="M37 22h3v12h-3z" fill="${c('rose')}"/>`,
  coffee: `<rect width="60" height="60" fill="${c('teal')}"/>
    <circle cx="46" cy="14" r="7" fill="none" stroke="${c('sand')}" stroke-width="1.4"/>
    <path d="M46 14v-4.5M46 14l3 2" stroke="${amber}" stroke-width="1.4" stroke-linecap="round"/>
    <path d="M23 21c-2 3 2 4 0 7M29 19c-2 3 2 4 0 7M35 21c-2 3 2 4 0 7" stroke="${c('paper')}" stroke-width="1.3" fill="none" opacity="0.6"/>
    <rect y="50" width="60" height="10" fill="${c('ink-dark')}" opacity="0.45"/>
    <ellipse cx="29" cy="50" rx="15" ry="2.6" fill="${c('sand')}"/>
    <path d="M19 34h20v7a7 7 0 0 1-7 7h-6a7 7 0 0 1-7-7z" fill="${c('paper')}"/>
    <path d="M39 36h2a3 3 0 0 1 0 6h-2" stroke="${c('paper')}" stroke-width="2" fill="none"/>
    <ellipse cx="29" cy="34" rx="10" ry="1.8" fill="${c('ink-dark')}"/>`,
  piranesi: `<rect width="60" height="60" fill="${c('teal')}"/>
    <path d="M0 10h60" stroke="${c('sand')}" stroke-width="2" opacity="0.5"/>
    <path d="M6 44V26a6 6 0 0 1 12 0v18zM24 44V26a6 6 0 0 1 12 0v18zM42 44V26a6 6 0 0 1 12 0v18z" fill="${c('ink-dark')}" opacity="0.55"/>
    <circle cx="30" cy="27" r="2" fill="${c('paper')}"/><path d="M27.5 42l1-12h3l1 12z" fill="${c('paper')}"/>
    <path d="M0 45c5-2 10-2 15 0s10 2 15 0 10-2 15 0 10 2 15 0V60H0z" fill="${c('ocean')}"/>
    <path d="M44 17q1.5-2 3 0q1.5-2 3 0" stroke="${c('paper')}" stroke-width="1.2" fill="none"/>`,
  morisaki: `<rect width="60" height="60" fill="${c('navy')}"/>
    <rect x="9" y="14" width="42" height="40" fill="${c('plum')}"/>
    <rect x="18" y="17" width="24" height="5" fill="${c('paper')}" opacity="0.85"/>
    <path d="M7 24h46l-3 4H10z" fill="${c('rose')}"/>
    <rect x="14" y="30" width="32" height="20" fill="${amber}"/>
    <path d="M17 33h2v15h-2zM20 35h2.5v13H20zM23.5 32h2v16h-2zM27 34h3v14h-3zM31 33h2v15h-2zM34 36h2.5v12H34zM38 32h2v16h-2zM41 34h2.5v14H41z" fill="${c('navy')}" opacity="0.7"/>
    <rect y="54" width="60" height="6" fill="${c('ink-dark')}"/>`,
} as const;

// Real titles, our own drawings: never the publishers' cover art. In-copyright rows sit
// under the user's own Audiobookshelf so the mockup doesn't suggest Lelap supplies them.
const rows: { name: string; source: string; books: Book[] }[] = [
  {
    name: 'Classics',
    source: 'LibriVox',
    books: [
      { title: 'Pride and Prejudice', art: art.pride },
      { title: 'Moby Dick', art: art.moby },
      { title: 'Jane Eyre', art: art.jane },
      { title: 'Frankenstein', art: art.frankenstein },
    ],
  },
  {
    name: 'Self-improvement',
    source: 'Audiobookshelf',
    books: [
      { title: 'Atomic Habits', art: art.atomic },
      { title: 'Four Thousand Weeks', art: art.weeks },
      { title: 'The Courage to Be Disliked', art: art.courage },
      { title: 'Meditations', art: art.meditations },
    ],
  },
  {
    name: 'Cozy and uncanny',
    source: 'Audiobookshelf',
    books: [
      { title: 'Strange Houses', art: art.strange },
      { title: 'Before the Coffee Gets Cold', art: art.coffee },
      { title: 'Piranesi', art: art.piranesi, progress: 40 },
      { title: 'Days at the Morisaki Bookshop', art: art.morisaki },
    ],
  },
];
---

<div class="stage" aria-hidden="true">
  <div class="phone phone-frame">
    <div class="head">
      <span class="heading">Catalogs</span>
      <Icon name="search" size={20} />
    </div>
    <div class="filters">
      <span class="filter active">Audiobooks</span>
      <span class="filter">Podcasts</span>
      <span class="filter">Downloaded</span>
    </div>
    {rows.map((row) => (
      <section class="row">
        <div class="row-head">
          <b>{row.name}</b>
          <span>{row.source}</span>
        </div>
        <div class="shelf">
          {row.books.map((book) => (
            <div class="book">
              <div class="tile">
                <svg viewBox="0 0 60 60" set:html={book.art} />
                {book.progress && (
                  <span class="tile-progress">
                    <span style={`width: ${book.progress}%`} />
                  </span>
                )}
              </div>
              <span class="caption">{book.title}</span>
            </div>
          ))}
        </div>
      </section>
    ))}
    <nav class="tabs">
      <span class="tab">
        <Icon name="home" size={20} />
        Home
      </span>
      <span class="tab active">
        <Icon name="grid" size={20} />
        Catalogs
      </span>
      <span class="tab">
        <Icon name="books" size={20} />
        Library
      </span>
    </nav>
  </div>
  <div class="float">
    <Icon name="box" size={18} />
    Rows come from your add-ons
  </div>
</div>

<style>
  .stage {
    position: relative;
    width: 340px;
    max-width: 100%;
    height: 620px;
    margin-inline: auto;
  }

  .phone {
    position: absolute;
    left: 0;
    top: 0;
    gap: 12px;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--fg-soft);
  }

  .heading {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--fg);
  }

  .filters {
    display: flex;
    gap: 6px;
  }

  .filter {
    padding: 4px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 11px;
    color: var(--fg-soft);
    white-space: nowrap;
  }

  .filter.active {
    border-color: var(--accent);
    background: var(--accent-tint);
    color: var(--accent);
    font-weight: 600;
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 13px;
  }

  .row-head span {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Bleeds past the right padding so the fourth cover peeks in, as on a real scrolling shelf. */
  .shelf {
    display: flex;
    gap: 9px;
    margin-right: -20px;
  }

  .book {
    flex: 0 0 74px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
  }

  .tile svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tile-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgb(0 0 0 / 0.35);
  }

  .tile-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
  }

  .caption {
    font-size: 10px;
    line-height: 1.2;
    color: var(--fg-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tabs {
    margin-top: auto;
    margin-inline: -20px;
    margin-bottom: -22px;
    padding: 10px 20px 14px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-around;
  }

  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    font-size: 10px;
    color: var(--muted);
  }

  .tab.active {
    color: var(--accent);
    font-weight: 600;
  }

  .float {
    position: absolute;
    right: 0;
    bottom: 76px;
    padding: 10px 12px;
    border-radius: 14px;
    background: #1c1f26;
    border: 1px solid #2e323c;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
  }

  .float :global(svg) {
    color: var(--accent);
  }
</style>
