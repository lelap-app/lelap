---
import Lori from '../components/Lori.astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';
import { splashImages } from '../splash-screens';
import { languages, t, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** The home page, which exists in every language: in-page anchors, hreflang links and the switch. */
  home?: boolean;
}

const { lang = 'en', home = false } = Astro.props;
const {
  title = `${site.name}: ${t(lang, site.descriptor)}`,
  description = `${t(lang, site.descriptor)} ${t(lang, site.tagline)} ${t(lang, 'Open source, works offline, no account.')}`,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const homePath = home ? languages[lang].home : '/';
const anchor = (id: string) => (home ? `#${id}` : `/#${id}`);
const other: Lang = lang === 'en' ? 'ms' : 'en';
// Docs, terms and privacy are English only; on a page in another language their links say so.
const english = lang === 'en' ? undefined : 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d0e11" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    {splashImages.map(({ href, media }) => (
      <link rel="apple-touch-startup-image" href={href} media={media} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={languages[lang].locale} />
    {home && (
      <>
        <meta property="og:locale:alternate" content={languages[other].locale} />
        {(Object.keys(languages) as Lang[]).map((code) => (
          <link
            rel="alternate"
            hreflang={code}
            href={new URL(languages[code].home, Astro.site).href}
          />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
      </>
    )}
    <script is:inline>
      // Scroll reveals, progressive: without this script nothing is hidden.
      (() => {
        if (!('IntersectionObserver' in window)) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('motion');
        addEventListener('DOMContentLoaded', () => {
          const io = new IntersectionObserver(
            (entries) => {
              for (const { isIntersecting, target } of entries) {
                if (!isIntersecting) continue;
                io.unobserve(target);
                // Drop the reveal styles once shown so hover transitions lose the stagger delay.
                const done = (e) => {
                  if (e.target !== target) return;
                  target.removeEventListener('transitionend', done);
                  target.removeAttribute('data-reveal');
                };
                target.addEventListener('transitionend', done);
                target.classList.add('in');
              }
            },
            { rootMargin: '0px 0px -8% 0px' },
          );
          document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
        });
      })();
    </script>
  </head>
  <body>
    <header class="container site-header">
      <a class="brand" href={homePath}>
        <Logo />
        {site.name}
      </a>
      <nav class="primary" aria-label={t(lang, 'Primary')}>
        <a href={anchor('how')}>{t(lang, 'How it works')}</a>
        <a href={anchor('features')}>{t(lang, 'Features')}</a>
        <a href={anchor('get')}>{t(lang, 'Get it')}</a>
        <a href={anchor('selfhost')}>{t(lang, 'Self-host')}</a>
        <a href={anchor('faq')}>{t(lang, 'FAQ')}</a>
        <a href="/docs/" hreflang={english}>
          {t(lang, 'Docs')}
        </a>
      </nav>
      <div class="header-actions">
        {home && (
          <a
            class="btn btn-sm lang-switch"
            href={languages[other].home}
            hreflang={other}
            lang={other}
          >
            <Icon name="globe" size={18} />
            <span class="lang-name">{languages[other].name}</span>
            <span class="lang-short" aria-hidden="true">
              {languages[other].short}
            </span>
          </a>
        )}
        <a class="btn btn-sm btn-outline" href={site.repoUrl}>
          <Icon name="code" size={18} />
          GitHub
        </a>
        {site.released && (
          <a class="btn btn-sm btn-primary" href={site.appUrl}>
            {t(lang, 'Start listening')}
          </a>
        )}
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <span class="footer-name">
            <Lori size={40} class="footer-lori" />
            {site.name}
          </span>
          <p class="muted">
            {t(lang, site.tagline)}{' '}
            {t(
              lang,
              '{name} does not host, index or link to any content. Add-ons are made and run by third parties.',
              { name: site.name },
            )}
          </p>
          {english && (
            <p class="muted">{t(lang, 'The docs, terms and privacy policy are in English.')}</p>
          )}
        </div>
        <nav aria-label={t(lang, 'Footer')} class="footer-nav">
          <a href={site.repoUrl}>GitHub</a>
          <a href={site.contributingUrl} hreflang={english}>
            {t(lang, 'Contribute')}
          </a>
          <a href={anchor('selfhost')}>{t(lang, 'Self-hosting')}</a>
          <a href="/docs/" hreflang={english}>
            {t(lang, 'Add-on docs')}
          </a>
          <a href="/terms" hreflang={english}>
            {t(lang, 'Terms')}
          </a>
          <a href="/privacy" hreflang={english}>
            {t(lang, 'Privacy')}
          </a>
          <a href={anchor('rights')}>{t(lang, 'Copyright')}</a>
          {site.released && <a href={site.appUrl}>{t(lang, 'Web app')}</a>}
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    padding-block: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
  }

  .primary {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
    margin-right: auto;
    font-size: 15px;
  }

  /* The page is short enough to scroll on phones; one header row beats a wrapped menu. */
  @media (max-width: 640px) {
    .primary {
      display: none;
    }

    .brand {
      margin-right: auto;
    }
  }

  .primary a,
  .footer-nav a {
    color: var(--fg-soft);
    padding-block: 10px;
  }

  .primary a:hover,
  .footer-nav a:hover {
    color: var(--fg);
  }

  .header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Plain text beside the GitHub button; a full-height target so it is easy to hit on a phone. */
  .lang-switch {
    padding-inline: 12px;
    color: var(--fg-soft);
    font-weight: 500;
  }

  .lang-switch:hover {
    color: var(--fg);
  }

  .lang-switch :global(svg) {
    color: var(--accent);
  }

  .lang-short {
    display: none;
  }

  /* Phones: “BM” or “EN” keeps the header on one row; the full name stays for screen readers. */
  @media (max-width: 420px) {
    .lang-short {
      display: inline;
    }

    .lang-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .site-footer {
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px 48px;
    padding-block: 40px 56px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 460px;
    font-size: 14px;
  }

  .footer-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    font-size: 15px;
  }
</style>
