---
import Lori from '../components/Lori.astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';
import { splashImages } from '../splash-screens';
import { languages, t, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** The home page, which exists in every language: in-page anchors, hreflang links and the switch. */
  home?: boolean;
}

const { lang = 'en', home = false } = Astro.props;
const {
  title = `${site.name}: ${t(lang, site.descriptor)}`,
  description = `${t(lang, site.descriptor)} ${t(lang, site.tagline)} ${t(lang, 'Open source, works offline, no account.')}`,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const homePath = home ? languages[lang].home : '/';
const anchor = (id: string) => (home ? `#${id}` : `/#${id}`);
const other: Lang = lang === 'en' ? 'ms' : 'en';
// Docs, terms and privacy are English only; on a page in another language their links say so.
const english = lang === 'en' ? undefined : 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* --bg of each theme; the script below points both at the one the switch picked. */}
    <meta
      name="theme-color"
      content="#f8f5ef"
      media="(prefers-color-scheme: light)"
      data-scheme="light"
    />
    <meta
      name="theme-color"
      content="#0d0e11"
      media="(prefers-color-scheme: dark)"
      data-scheme="dark"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    {splashImages.map(({ href, media }) => (
      <link rel="apple-touch-startup-image" href={href} media={media} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={languages[lang].locale} />
    {home && (
      <>
        <meta property="og:locale:alternate" content={languages[other].locale} />
        {(Object.keys(languages) as Lang[]).map((code) => (
          <link
            rel="alternate"
            hreflang={code}
            href={new URL(languages[code].home, Astro.site).href}
          />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
      </>
    )}
    <script is:inline>
      // Theme before first paint, so a saved choice never flashes the other one. Without this
      // script the page follows prefers-color-scheme and the switch stays hidden.
      (() => {
        const root = document.documentElement;
        const themes = ['system', 'light', 'dark'];
        let theme = 'system';
        try {
          theme = localStorage.getItem('lelap-theme') || 'system';
        } catch {
          // Storage blocked: follow the system.
        }
        if (!themes.includes(theme)) theme = 'system';
        const apply = () => {
          if (theme === 'system') delete root.dataset.theme;
          else root.dataset.theme = theme;
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
            const scheme = meta.dataset.scheme;
            meta.media =
              theme === 'system'
                ? `(prefers-color-scheme: ${scheme})`
                : scheme === theme
                  ? 'all'
                  : 'not all';
          }
        };
        apply();
        // Shows the switch from the first paint (see .theme-switch), so the header never shifts.
        root.dataset.js = '';
        addEventListener('DOMContentLoaded', () => {
          const button = document.querySelector('[data-theme-switch]');
          if (!button) return;
          const label = button.querySelector('[data-theme-label]');
          const show = () => {
            label.textContent = button.dataset[theme];
          };
          show();
          button.hidden = false;
          button.addEventListener('click', () => {
            // The first click always changes what you see: system, its opposite, then its own.
            const order = matchMedia('(prefers-color-scheme: dark)').matches
              ? ['system', 'light', 'dark']
              : ['system', 'dark', 'light'];
            theme = order[(order.indexOf(theme) + 1) % order.length];
            try {
              if (theme === 'system') localStorage.removeItem('lelap-theme');
              else localStorage.setItem('lelap-theme', theme);
            } catch {
              // Storage blocked: the choice holds for this page only.
            }
            apply();
            show();
          });
        });
      })();
      // Scroll reveals, progressive: without this script nothing is hidden.
      (() => {
        if (!('IntersectionObserver' in window)) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('motion');
        addEventListener('DOMContentLoaded', () => {
          const io = new IntersectionObserver(
            (entries) => {
              for (const { isIntersecting, target } of entries) {
                if (!isIntersecting) continue;
                io.unobserve(target);
                // Drop the reveal styles once shown so hover transitions lose the stagger delay.
                const done = (e) => {
                  if (e.target !== target) return;
                  target.removeEventListener('transitionend', done);
                  target.removeAttribute('data-reveal');
                };
                target.addEventListener('transitionend', done);
                target.classList.add('in');
              }
            },
            { rootMargin: '0px 0px -8% 0px' },
          );
          document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
        });
      })();
    </script>
  </head>
  <body>
    <header class="container site-header">
      <a class="brand" href={homePath}>
        <Logo />
        {site.name}
      </a>
      <nav class="primary" aria-label={t(lang, 'Primary')}>
        <a href={anchor('how')}>{t(lang, 'How it works')}</a>
        <a href={anchor('features')}>{t(lang, 'Features')}</a>
        <a href={anchor('get')}>{t(lang, 'Get it')}</a>
        <a href={anchor('selfhost')}>{t(lang, 'Self-host')}</a>
        <a href={anchor('faq')}>{t(lang, 'FAQ')}</a>
        <a href="/docs/" hreflang={english}>
          {t(lang, 'Docs')}
        </a>
      </nav>
      <div class="header-actions">
        {home && (
          <a
            class="btn btn-sm lang-switch"
            href={languages[other].home}
            hreflang={other}
            lang={other}
            aria-label={`${languages[other].name} (${languages[other].short})`}
          >
            <Icon name="globe" size={18} />
            <span class="lang-name">{languages[other].name}</span>
            <span class="lang-short">{languages[other].short}</span>
          </a>
        )}
        {/* Cycles system, light and dark. Its name says the current choice. Shown by the script. */}
        <button
          type="button"
          class="btn btn-sm theme-switch"
          data-theme-switch
          data-system={t(lang, 'Theme: follows the system')}
          data-light={t(lang, 'Theme: light')}
          data-dark={t(lang, 'Theme: dark')}
          hidden
        >
          <span class="theme-icon" data-for="system">
            <Icon name="contrast" size={18} />
          </span>
          <span class="theme-icon" data-for="light">
            <Icon name="sun" size={18} />
          </span>
          <span class="theme-icon" data-for="dark">
            <Icon name="moon" size={18} />
          </span>
          <span class="visually-hidden" data-theme-label>
            {t(lang, 'Theme: follows the system')}
          </span>
        </button>
        <a class="btn btn-sm btn-outline" href={site.repoUrl}>
          <Icon name="code" size={18} />
          GitHub
        </a>
        {site.released && (
          <a class="btn btn-sm btn-primary" href={site.appUrl}>
            {t(lang, 'Start listening')}
          </a>
        )}
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <span class="footer-name">
            <Lori size={40} class="footer-lori" />
            {site.name}
          </span>
          <p class="muted">
            {t(lang, site.tagline)}{' '}
            {t(
              lang,
              '{name} does not host, index or link to any content. Add-ons are made and run by third parties.',
              { name: site.name },
            )}
          </p>
          {english && (
            <p class="muted">{t(lang, 'The docs, terms and privacy policy are in English.')}</p>
          )}
        </div>
        <nav aria-label={t(lang, 'Footer')} class="footer-nav">
          <a href={site.repoUrl}>GitHub</a>
          <a href={site.contributingUrl} hreflang={english}>
            {t(lang, 'Contribute')}
          </a>
          <a href={anchor('selfhost')}>{t(lang, 'Self-hosting')}</a>
          <a href="/docs/" hreflang={english}>
            {t(lang, 'Add-on docs')}
          </a>
          <a href="/terms" hreflang={english}>
            {t(lang, 'Terms')}
          </a>
          <a href="/privacy" hreflang={english}>
            {t(lang, 'Privacy')}
          </a>
          <a href={anchor('rights')}>{t(lang, 'Copyright')}</a>
          {site.released && <a href={site.appUrl}>{t(lang, 'Web app')}</a>}
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    padding-block: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
  }

  .primary {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
    margin-right: auto;
    font-size: 15px;
  }

  /* The page is short enough to scroll on phones; one header row beats a wrapped menu. */
  @media (max-width: 640px) {
    .primary {
      display: none;
    }

    .brand {
      margin-right: auto;
    }
  }

  .primary a,
  .footer-nav a {
    color: var(--fg-soft);
    padding-block: 10px;
  }

  .primary a:hover,
  .footer-nav a:hover {
    color: var(--fg);
  }

  .header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Plain text beside the GitHub button; a full-height target so it is easy to hit on a phone. */
  .lang-switch {
    position: relative;
    padding-inline: 12px;
    color: var(--fg-soft);
    font-weight: 500;
  }

  .lang-switch:hover {
    color: var(--fg);
  }

  .lang-switch :global(svg) {
    color: var(--accent);
  }

  .lang-short {
    display: none;
  }

  /* A 44 px icon button; .btn's display would otherwise win over [hidden]. */
  .theme-switch {
    position: relative;
    width: 44px;
    padding: 0;
    justify-content: center;
    border: none;
    background: none;
    color: var(--fg-soft);
    font: inherit;
    cursor: pointer;
  }

  .theme-switch:hover {
    color: var(--fg);
  }

  .theme-switch[hidden] {
    display: none;
  }

  /* The head script marks the page before first paint; without it the switch stays hidden. */
  :global(:root[data-js]) .theme-switch[hidden] {
    display: inline-flex;
  }

  .theme-icon {
    display: none;
  }

  /* The icon follows the root's data-theme, which is set before first paint. */
  :global(:root:not([data-theme])) [data-for='system'],
  :global(:root[data-theme='light']) [data-for='light'],
  :global(:root[data-theme='dark']) [data-for='dark'] {
    display: flex;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Phones: “BM” or “EN” keeps the header on one row; the name says both, for voice control. */
  @media (max-width: 420px) {
    .site-header {
      column-gap: 12px;
    }

    .header-actions {
      gap: 4px;
    }

    .lang-short {
      display: inline;
    }

    .lang-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .site-footer {
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px 48px;
    padding-block: 40px 56px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 460px;
    font-size: 14px;
  }

  .footer-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    font-size: 15px;
  }
</style>
