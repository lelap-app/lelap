---
import Base from './Base.astro';
import { site } from '../site';

interface Props {
  title: string;
  description: string;
  /** Sections of this page, listed under its entry in the docs nav. */
  toc?: [id: string, label: string][];
}

const { title, description, toc = [] } = Astro.props;
const pages = [
  { href: '/docs/', label: 'Overview' },
  { href: '/docs/protocol/', label: 'Protocol v1' },
  { href: '/docs/sdk/', label: 'SDK guide' },
];
const current = Astro.url.pathname.replace(/\/?$/, '/');
---

<Base title={`${title} · ${site.name} docs`} description={description}>
  <div class="container docs-shell">
    <nav class="docs-nav" aria-label="Docs">
      <span class="docs-nav-head">Add-on docs</span>
      <ul>
        {pages.map((page) => (
          <li>
            <a href={page.href} aria-current={page.href === current ? 'page' : undefined}>
              {page.label}
            </a>
            {page.href === current && toc.length > 0 && (
              <ul class="docs-toc">
                {toc.map(([id, label]) => (
                  <li>
                    <a href={`#${id}`}>{label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <article class="docs">
      <slot />
    </article>
  </div>
</Base>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 56px;
    padding-block: clamp(32px, 5vw, 64px);
  }

  @media (max-width: 860px) {
    .docs-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }

  .docs-nav {
    font-size: 15px;
  }

  @media (min-width: 861px) {
    .docs-nav {
      position: sticky;
      top: 24px;
      align-self: start;
      max-height: calc(100vh - 48px);
      overflow-y: auto;
    }
  }

  .docs-nav-head {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .docs-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-nav a {
    display: block;
    padding-block: 6px;
    color: var(--fg-soft);
  }

  .docs-nav a:hover,
  .docs-nav a[aria-current='page'] {
    color: var(--fg);
  }

  .docs-nav a[aria-current='page'] {
    font-weight: 600;
  }

  .docs-nav .docs-toc {
    margin-bottom: 6px;
    padding-left: 12px;
    border-left: 1px solid var(--line-strong);
    font-size: 14px;
  }

  .docs-toc a {
    padding-block: 4px;
    color: var(--muted);
  }

  /* Page content comes from the slot, so these rules reach into it with :global. */
  .docs {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .docs :global(h1) {
    font-size: clamp(34px, 5vw, 48px);
    letter-spacing: -0.02em;
  }

  .docs :global(h2) {
    font-size: 26px;
    margin-top: 28px;
    scroll-margin-top: 16px;
  }

  .docs :global(h3) {
    font-size: 19px;
    margin-top: 12px;
    scroll-margin-top: 16px;
  }

  .docs :global(p),
  .docs :global(li) {
    color: var(--fg-soft);
    font-size: 17px;
    line-height: 1.65;
  }

  .docs :global(.lead) {
    font-size: 19px;
  }

  .docs :global(ul),
  .docs :global(ol) {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .docs :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: var(--surface);
    color: var(--fg);
    font-size: 0.88em;
    overflow-wrap: anywhere;
  }

  .docs :global(.note) {
    padding: 16px 20px;
    border-left: 3px solid var(--accent);
    border-radius: 0 12px 12px 0;
    background: var(--accent-tint);
  }

  .docs :global(.note p) {
    color: var(--fg);
  }
</style>
