{
  "name": "@lelap/sdk",
  "version": "0.7.0",
  "description": "Types, schemas and a request handler for Lelap add-ons.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelap-app/lelap.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/lelap-app/lelap/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/lelap-app/lelap/issues",
  "keywords": [
    "lelap",
    "addon",
    "audiobook",
    "podcast",
    "sdk"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./check": "./src/check.ts"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./check": {
        "types": "./dist/check.d.ts",
        "default": "./dist/check.js"
      },
      "./protocol.schema.json": "./dist/protocol.schema.json",
      "./package.json": "./package.json"
    },
    "bin": {
      "lelap-sdk": "./dist/bin.js"
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/esm-paths.mjs && node scripts/schema.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node -e \"console.error('Publish the tarball from pnpm pack instead: it applies publishConfig.exports. See README.md.'); process.exit(1)\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
