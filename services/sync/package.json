{
  "name": "@lelap/sync",
  "version": "0.1.0",
  "private": true,
  "description": "Encrypted sync for Lelap: stores sealed messages it cannot read.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply lelap-sync --local && wrangler dev --port 8789",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@lelap/core": "workspace:*",
    "@types/sql.js": "^1.4.11",
    "drizzle-orm": "^0.45.4",
    "sql.js": "^1.15.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
