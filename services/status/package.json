  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.15.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
