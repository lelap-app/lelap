{
  "name": "@lelap/status",
  "version": "0.1.0",
  "private": true,
  "description": "Status page for Lelap's hosted services: checks every 5 minutes, 7 days kept.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790 --test-scheduled",
