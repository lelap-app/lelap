{
  "name": "lelap",
  "private": true,
  "description": "The open player for audiobooks and podcasts.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev:site": "pnpm --filter @lelap/site dev",
    "dev:app": "pnpm --filter @lelap/app start",
    "android": "pnpm --filter @lelap/app android",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
