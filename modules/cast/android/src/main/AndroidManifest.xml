<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Control messages to receivers and the small server they fetch phone files from. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- The phone's Wi-Fi address, which receivers fetch phone files from. -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <!-- SSDP and mDNS answers arrive as multicast, which Wi-Fi drops without a multicast lock. -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <!-- A Wi-Fi lock keeps the file server reachable while the screen is off. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
