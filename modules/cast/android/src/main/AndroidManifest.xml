<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Control messages to receivers and the small server they fetch phone files from. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- The phone's Wi-Fi address, which receivers fetch phone files from. -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <!-- SSDP and mDNS answers arrive as multicast, which Wi-Fi drops without a multicast lock. -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <!-- A Wi-Fi lock keeps the file server reachable while the screen is off; a wake lock keeps the
       session's poll running while a receiver plays. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Android 17: discovery, receivers and the file server are on the local network. Asked at run
       time, with an explanation, on every Android 17 device: it is enforced at target 36 too
       (LocalNetwork.kt in modules/netfs). -->
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
</manifest>
