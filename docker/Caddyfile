# Serves the web app; every unknown path is the app itself (client-side routes).
:8080 {
	root * /srv
	encode zstd gzip
	# App Links (M90): the build keeps the file out of a hidden folder.
	rewrite /.well-known/assetlinks.json /well-known/assetlinks.json
	try_files {path} /index.html
	file_server
	import headers.caddy
	header /_expo/* Cache-Control "public, max-age=31536000, immutable"
}
