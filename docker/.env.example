# Copy to .env next to compose.yml and change what you need; every line is optional.
# .env stays out of git.

# Your domain: the app finds its services at listen., catalog., proxy. and sync.<domain>.
LELAP_DOMAIN=localhost

# Image tag: latest (stable releases), beta, or a version such as 0.2.
LELAP_TAG=latest

# HTTPS through the bundled Caddy (needs the four names in DNS, ports 80 and 443 free).
# Add updates for Android builds of your own: COMPOSE_PROFILES=https,updates
# COMPOSE_PROFILES=https

# Made on first start and kept in the secrets volume when empty. Set them only to choose
# your own: ADMIN_TOKEN 16 characters or more, CONFIG_SECRET 32 or more.
ADMIN_TOKEN=
CONFIG_SECRET=

# Where the admin pages listen on the host. 127.0.0.1 keeps them off the network.
ADMIN_BIND=127.0.0.1
# true: the admin pages also answer public addresses (the token is still needed).
ADMIN_ALLOW_REMOTE=false

# Podcast Index catalogs and podcast search: free keys from api.podcastindex.org.
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=

# The web app's origin, for the proxy's CORS header (for example https://listen.example.org).
WEB_ORIGIN=*

# Delete sync groups no device synced with for this many days. Empty or 0: never.
SYNC_IDLE_EXPIRY_DAYS=

# Feeds or a gPodder server on your own network. Keep the services private if you allow these.
PROXY_ALLOW_PRIVATE=false
SCROBBLE_ALLOW_PRIVATE=false
